{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openai": {
      "options": {
        "baseURL": "http://localhost:1234/v1/",
        "apiKey": "not-needed"
      }
    }
  },
  "model": "openai/qwen-agentworld-35b-a3b-mtp-apex",
  "small_model": "openai/qwen-agentworld-35b-a3b-mtp-apex",
  "permission": {
    "edit": "allow",
    "bash": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "task": "allow",
    "websearch": "allow",
    "webfetch": "allow"
  },
  "mcp": {
    "chimera-engine": {
      "type": "stdio",
      "command": "python",
      "args": ["ChimeraEngine/mcp_server.py"],
      "enabled": true
    },
    "playwright": {
      "type": "stdio",
      "command": "C:\\Users\\allen\\node-portable\\node-v22.23.1-win-x64\\node.exe",
      "args": ["node_modules/@playwright/mcp/cli.js"],
      "env": { "PLAYWRIGHT_BROWSERS_PATH": "C:\\Users\\allen\\AppData\\Local\\ms-playwright" },
      "enabled": true
    }
  }
}