{
	"mcpServers": {
		"playwright": {
			"command": "npx",
			"args": [
				"@playwright/mcp@latest"
			],
			"alwaysAllow": [
				"browser_navigate",
				"browser_snapshot",
				"browser_take_screenshot",
				"browser_click",
				"browser_find",
				"browser_evaluate",
				"browser_tabs",
				"browser_navigate_back",
				"browser_close",
				"browser_network_requests"
			]
		},
		"graphify": {
			"command": "C:\\Users\\allen\\AppData\\Roaming\\Python\\Python314\\Scripts\\graphify-mcp.exe",
			"args": [
				"E:/PythonChimera/Chimera/docs/chimera_knowledge_graph.json"
			],
			"cwd": "E:/PythonChimera/Chimera",
			"alwaysAllow": [
				"query_graph",
				"get_node",
				"graph_stats"
			]
		},
		"filesystem": {
			"command": "npx",
			"args": [
				"@modelcontextprotocol/server-filesystem",
				"E:/PythonChimera"
			],
			"alwaysAllow": [
				"read_text_file",
				"write_file",
				"search_files",
				"read_multiple_files",
				"list_directory",
				"directory_tree"
			]
		}
	}
}
