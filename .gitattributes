* text=auto
*.bat text eol=crlf
*.ps1 text eol=crlf
*.uasset binary
*.umap binary
*.png binary
*.jar binary
*.exe binary

# evidence-forensics-byte-stability-01 (PR #73 review LOW-1; PR #69 gen-2 HIGH root):
# sha-recorded evidence must be checkout-invariant. Last match wins over * text=auto:
# no eol/encoding conversion either way, so checkout bytes == committed bytes and
# recorded sha256s verify on every platform. Enumerated classes (all under docs/evidence/**):
# capture sidecars, MANIFEST_sha256.txt manifests, DYAD request specs/responses,
# unblinding maps, raw consoles recording payload hashes, run records.
docs/evidence/** -text

# Immutable graph-contract measurement bytes across Windows checkouts.
agent_logs/codex/graph_contracts_20260915/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Preserve graph-workflow proof bytes across checkouts.
tools/agent_fleet/graph_workflow/validation/*.log -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
tools/science_funnel/examples/* -text
tools/science_funnel/validation/** -text whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol

# Downloaded scientific artifacts are SHA-pinned upstream bytes.
tools/science_funnel/data/coolprop/** -text
tools/science_funnel/data/pubchem/** -text
# Preserve pinned scientific downloads, including source line endings.
tools/science_funnel/data/force_sources/** -text -whitespace

# Anatomical source captures retain their upstream bytes for checksum replay.
tools/science_funnel/data/bodyparts3d/** -text -whitespace

tools/science_funnel/data/macaque_arm/** -text -whitespace

tools/science_funnel/data/earth/** -text -whitespace

# Every batch-connector data dir pins upstream bytes for checksum replay
# (broad law over the per-dir rules above; last match wins over * text=auto).
tools/science_funnel/data/** -text
