// hinge.comp — the first CA-field kernel (operator decree 2026-08-28: develop
// ON the CA field, not in Python). Per-vertex CA state: blend weights (static),
// one global phase (the clock), Rodrigues about the measured joint — the same
// skin-moving law the operator approved, executed on the GPU at render rate.
// Atomic-free by construction (one invocation per vertex, disjoint writes);
// fixed order; wave-size independent.
#version 460
layout(local_size_x = 256) in;

layout(push_constant) uniform PC {
    vec4  JL;
    vec4  JR;
    vec4  axis;
    float romL;
    float romR;
    float period;
    float phaseR;
    float time_s;
    float thetaL;   // gait mode (H7): commanded L knee angle (deg)
    float thetaR;   // gait mode: commanded R knee angle (deg)
    uint  flags;    // bit0: pose from thetaL/thetaR (gait CPG) not the cosine march
                    // bit1: strain tint on (binding 4 carries per-vertex area strain)
    uint  n;
} pc;

layout(std430, binding = 0) readonly  buffer Rest   { float rest[];   };
layout(std430, binding = 1) readonly  buffer WL     { float wL[];     };
layout(std430, binding = 2) readonly  buffer WR     { float wR[];     };
layout(std430, binding = 3) writeonly buffer Out    { float vout[];   };
layout(std430, binding = 4) readonly  buffer Strain { float strain[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;

    float a = wL[i], b = wR[i];
    if (a == 0.0 && b == 0.0) {
        for (uint k = 0; k < 9; ++k) vout[i * 9 + k] = rest[i * 9 + k];
        return;
    }

    float th;
    if ((pc.flags & 1u) != 0u) {
        // gait CPG drives the knees: theta in degrees, straight from the engine's
        // gait clock (H7 stage 2) — no open-loop cosine here.
        th = (pc.thetaL * a + pc.thetaR * b) * 0.0174533;
    } else {
        float ph = fract(pc.time_s / pc.period);
        float bL = 0.5 - 0.5 * cos(6.2831853 * ph);
        float bR = 0.5 - 0.5 * cos(6.2831853 * ph + pc.phaseR);
        th = (bL * pc.romL * a + bR * pc.romR * b) * 0.0174533;
    }
    vec3 J = (a >= b) ? pc.JL.xyz : pc.JR.xyz;
    float c = cos(th), s = sin(th);

    for (uint kk = 0; kk < 2; ++kk) {              // 0 = position, 1 = normal
        vec3 base = (kk == 0) ? J : vec3(0.0);
        vec3 v = vec3(rest[i * 9 + kk * 3 + 0],
                      rest[i * 9 + kk * 3 + 1],
                      rest[i * 9 + kk * 3 + 2]) - base;
        vec3 r = v * c + cross(pc.axis.xyz, v) * s + pc.axis.xyz * dot(pc.axis.xyz, v) * (1.0 - c);
        vec3 o = r + base;
        vout[i * 9 + kk * 3 + 0] = o.x;
        vout[i * 9 + kk * 3 + 1] = o.y;
        vout[i * 9 + kk * 3 + 2] = o.z;
    }
    float cr = rest[i * 9 + 6];                    // colors pass through
    float cg = rest[i * 9 + 7];
    float cb = rest[i * 9 + 8];
    if ((pc.flags & 2u) != 0u) {
        // THE STRAIN OVERLAY: true area strain from the engine's CPU mirror of
        // THIS law, tinted onto the membrane — blue = compression, red =
        // stretch, +/-10% saturates the ramp, 0 = rest color. Same math as the
        // CPU fallback path (Engine::pose_hinge), one law, two executors.
        float s = strain[i] * 10.0;                    // 1.0 at the +/-10% saturation point
        float t = clamp(abs(s), 0.0, 1.0);
        if (s >= 0.0) {                                // stretch: toward red
            cr = min(cr + 0.55 * t, 1.0);
            cg = min(cg + 0.10 * t, 1.0);
            cb = max(cb - 0.55 * t, 0.0);
        } else {                                       // compression: toward blue
            cr = max(cr - 0.35 * t, 0.0);
            cg = max(cg - 0.10 * t, 0.0);
            cb = min(cb + 0.55 * t, 1.0);
        }
    }
    vout[i * 9 + 6] = cr;
    vout[i * 9 + 7] = cg;
    vout[i * 9 + 8] = cb;
}
