// joints.comp — H15: the all-joints articulation kernel. The knee law,
// generalized to the whole skeleton. Atomic-free (one invocation per vertex,
// disjoint writes), fixed order, wave-size independent.
//
// TWO POSE LAWS, one kernel (JNT2, 2026-09-03). The pack version picks the
// law; the law is not a preference, it is the wire format's meaning:
//
//  LEGACY (JNT1, pc.legacy = 1) — per vertex, a dominant joint + weight,
//    Rodrigues about that joint's center/axis by theta[joint] * w. This is
//    the exact H15 law as shipped; a JNT1 pack must pose bit-identically
//    forever (the falsifier was named before this file was rewritten).
//
//  LBS (JNT2, pc.legacy = 0) — 2-bone linear-blend skinning. The tear at full
//    flexion exists because rotations don't interpolate linearly: adjacent
//    crease verts scale theta differently (112 deg vs 62 deg about the same
//    pivot) and the surface pulls apart. LBS blends TRANSFORMS instead:
//
//        v' = w_i * F_own(v)   +   (1 - w_i) * F_parent-of-band(v)
//
//    where F is a COMPOSED FK WORLD FRAME (2026-09-04, the operator's
//    fingertip conviction): shipped-first-draft blended two SINGLE-LEVEL
//    rotations about independent pivots, so an ancestor's arc reached a deep
//    band only diluted by (1-w) — bending the elbow left the hand behind and
//    the skin stretched. The law of every rigged character: a joint's pose
//    is the COMPOSITION of its whole FK chain, own rotation first, every
//    level about its own FIXED REST pivot:
//
//        p' = R_own( R_parent( ... R_root( p ) ) )
//
//    accumulated root->own as an affine (M, T) with
//        R_k = Rodrigues(a_k, theta_k),  t_k = J_k - R_k J_k,
//        M <- R_k M,  T <- R_k T + t_k  per level.
//    Term 2 is the same accumulation STOPPING BEFORE the band joint (the
//    parent's world frame; identity when the band joint is parentless). At
//    any angle the output is a convex combination of two rigid motions of
//    the SAME rest point, so wherever w varies smoothly the surface stays
//    connected — and now the ancestor motion is SHARED by both terms, so a
//    vertex inherits 100% of every ancestor's arc plus its own blended arc.
//    At rest (all thetas 0) every R_k is exactly I and t_k exactly 0, so the
//    rest pose is bit-identical by construction.
//    NOTE: chains deeper than 8 truncate (named boundary; this skeleton's
//    deepest chain is 4: spine_lower -> shoulder -> elbow -> wrist).
//
// C1: WEIGHT-PAINT mode (pc.paint >= 0). Blender's weight-paint law: the
// selected joint's band is colored by its own weight (blue 0 -> green ->
// yellow -> red 1); every other vert dims to a quarter of its rest color.
// The paint is the mesh's own vertex colors, not chrome — it is the pack's
// w data made visible, nothing invented.
#version 460
layout(local_size_x = 256) in;

layout(push_constant) uniform PC {
    uint n;
    uint n_joints;
    int  paint;      // C1: joint index to weight-paint, -1 = off
    uint flags;      // bit0: legacy pose law (JNT1) — else 2-bone LBS (JNT2)
} pc;

layout(std430, binding = 0) readonly  buffer Rest    { float rest[]; };
layout(std430, binding = 1) readonly  buffer Assign  { int   joint[]; };   // joint idx or -1
layout(std430, binding = 2) readonly  buffer Weights { float w[]; };
// joints state: per joint 8 floats [Jx Jy Jz Ax Ay Az 0 theta(rad)]
layout(std430, binding = 3) readonly  buffer JState  { float js[]; };
layout(std430, binding = 4) buffer Out      { float vout[]; };      // In+Out: the tint reads back its own pass-through colors
layout(std430, binding = 5) readonly  buffer Parent  { int   parent[]; };  // JNT2: FK parent per joint (-1 = none)
layout(std430, binding = 6) readonly  buffer Strain  { float strain[]; };  // per-vert area strain (CPU mirror of THIS law)

vec3 heat(float w) {                          // the standard weight ramp on [0,1]
    w = clamp(w, 0.0, 1.0);
    if (w < 1.0 / 3.0) return mix(vec3(0.0, 0.0, 1.0), vec3(0.0, 1.0, 0.0), w * 3.0);
    if (w < 2.0 / 3.0) return mix(vec3(0.0, 1.0, 0.0), vec3(1.0, 1.0, 0.0), w * 3.0 - 1.0);
    return mix(vec3(1.0, 1.0, 0.0), vec3(1.0, 0.0, 0.0), w * 3.0 - 2.0);
}

// Rodrigues rotation of position (about pivot Jp) or normal (about origin,
// kk=1). The shared hinge/joints convention, verbatim.
vec3 rodr(vec3 v, vec3 a, float c, float s, vec3 Jp) {
    return v * c + cross(a, v) * s + a * dot(a, v) * (1.0 - c) + Jp;
}

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;

    int j = joint[i];
    if (j < 0) {
        for (uint k = 0; k < 9; ++k) vout[i * 9 + k] = rest[i * 9 + k];
        if (pc.paint >= 0) {                  // unassigned verts dim like any non-band vert
            vout[i * 9 + 6] *= 0.25; vout[i * 9 + 7] *= 0.25; vout[i * 9 + 8] *= 0.25;
        }
        return;
    }
    float wgt = w[i];

    uint jo = uint(j) * 8u;
    vec3 J1 = vec3(js[jo + 0u], js[jo + 1u], js[jo + 2u]);
    vec3 a1 = vec3(js[jo + 3u], js[jo + 4u], js[jo + 5u]);
    float th1 = js[jo + 7u];

    if ((pc.flags & 1u) != 0u) {
        // ── LEGACY (JNT1): theta scaled by the vertex's own weight. Exact
        // shipped H15 law — do not touch; the bit-compat prediction holds it.
        float th = th1 * wgt;
        float c = cos(th), s = sin(th);
        for (uint kk = 0; kk < 2; ++kk) {            // 0 = position, 1 = normal
            vec3 base = (kk == 0) ? J1 : vec3(0.0);
            vec3 v = vec3(rest[i * 9 + kk * 3 + 0],
                          rest[i * 9 + kk * 3 + 1],
                          rest[i * 9 + kk * 3 + 2]) - base;
            vec3 r = v * c + cross(a1, v) * s + a1 * dot(a1, v) * (1.0 - c);
            vec3 o = r + base;
            vout[i * 9 + kk * 3 + 0] = o.x;
            vout[i * 9 + kk * 3 + 1] = o.y;
            vout[i * 9 + kk * 3 + 2] = o.z;
        }
    } else {
        // ── LBS (JNT2): blend the two COMPOSED world frames of this rest vert.
        // Walk the FK chain root->own once; term 1 consumes the whole chain,
        // term 2 stops before the band joint (the parent's frame).
        int chain[8]; int depth = 0;
        int cj = j;
        while (cj >= 0 && depth < 8) { chain[depth++] = cj; cj = parent[cj]; }
        mat3 M1 = mat3(1.0); vec3 T1 = vec3(0.0);
        mat3 M2 = mat3(1.0); vec3 T2 = vec3(0.0);
        for (int k = depth - 1; k >= 0; --k) {      // root first, own last
            uint po = uint(chain[k]) * 8u;
            vec3 Jk = vec3(js[po + 0u], js[po + 1u], js[po + 2u]);
            vec3 ak = vec3(js[po + 3u], js[po + 4u], js[po + 5u]);
            float tk = js[po + 7u];
            float ck = cos(tk), sk = sin(tk);
            // Rodrigues as a matrix: R = c I + (1-c) a a^T + s [a]x
            mat3 Rk = ck * mat3(1.0)
                    + (1.0 - ck) * outerProduct(ak, ak)
                    + sk * mat3(vec3(0.0,  ak.z, -ak.y),
                                vec3(-ak.z, 0.0,  ak.x),
                                vec3( ak.y, -ak.x, 0.0));
            vec3 off = Jk - Rk * Jk;                // the pivot's translation
            T1 = Rk * T1 + off;  M1 = Rk * M1;
            if (k > 0) { T2 = Rk * T2 + off;  M2 = Rk * M2; }
        }
        for (uint kk = 0; kk < 2; ++kk) {            // 0 = position, 1 = normal
            vec3 v = vec3(rest[i * 9 + kk * 3 + 0],
                          rest[i * 9 + kk * 3 + 1],
                          rest[i * 9 + kk * 3 + 2]);
            vec3 r1 = M1 * v + T1;                  // band joint's world frame
            vec3 r2 = M2 * v + T2;                  // parent's world frame
            vec3 o = wgt * r1 + (1.0 - wgt) * r2;   // the convex blend — the cure
            vout[i * 9 + kk * 3 + 0] = o.x;
            vout[i * 9 + kk * 3 + 1] = o.y;
            vout[i * 9 + kk * 3 + 2] = o.z;
        }
    }
    float cr = rest[i * 9 + 6];                    // colors: rest by default
    float cg = rest[i * 9 + 7];
    float cb = rest[i * 9 + 8];
    if (pc.paint >= 0) {
        vec3 col = (j == pc.paint) ? heat(w[i])
                                   : vec3(cr, cg, cb) * 0.25;
        cr = col.x; cg = col.y; cb = col.z;
    }
    if ((pc.flags & 2u) != 0u) {
        // THE STRAIN OVERLAY, JOINTS LANE (2026-09-04): the SAME ramp the hinge
        // lane ships (hinge.comp bit1) over the SAME scalar the CPU mirror of
        // THIS law computes (Engine::compute_strain_joints) — blue =
        // compression, red = stretch, +/-10% saturates. Written to Out (also
        // bound read-only) so the next frame's pass-through sees the REST
        // colors — the tint is per-frame chrome, never a cumulative stain.
        float s = strain[i] * 10.0;
        float t = clamp(abs(s), 0.0, 1.0);
        if (s >= 0.0) {
            cr = min(cr + 0.55 * t, 1.0);
            cg = min(cg + 0.10 * t, 1.0);
            cb = max(cb - 0.55 * t, 0.0);
        } else {
            cr = max(cr - 0.35 * t, 0.0);
            cg = max(cg - 0.10 * t, 0.0);
            cb = min(cb + 0.55 * t, 1.0);
        }
    }
    vout[i * 9 + 6] = cr;
    vout[i * 9 + 7] = cg;
    vout[i * 9 + 8] = cb;
}
