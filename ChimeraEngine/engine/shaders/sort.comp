#version 450
// GPU sort for 3DGS back-to-front splat ordering. Two modes via push constant:
//   mode 0 = compute a sortable uint key from view-space depth (monotonic: uint order == depth order)
//   mode 1 = one bitonic compare-swap step (sorts indices ascending by (key, index))
// Bitonic sort is a comparison sort — with the (key, index) tie-break it realizes a
// STABLE TOTAL ORDER: the sorted permutation is unique, so renders are reproducible
// across re-uploads (agent/engine-determinism-argc, 2026-09-20). Runs entirely on
// the GPU so the CPU never touches per-splat data.
layout(local_size_x = 256) in;

layout(std430, binding = 0) buffer PosB { float pos[]; };    // N*14 floats (engine vertex layout)
layout(std430, binding = 1) buffer KeyB { uint  keys[]; };   // N (padded) sortable keys
layout(std430, binding = 2) buffer IdxB { uint  indices[]; };// N (padded) permutation

layout(push_constant) uniform PC {
    uint  mode;    // 0 = keys, 1 = bitonic step
    uint  j;       // bitonic sub-stage
    uint  k;       // bitonic stage
    uint  count;   // real splat count N (unpadded)
    float zx, zy, zz, tz;  // view-space depth: depth = zx*x + zy*y + zz*z + tz
};

void main() {
    uint i = gl_GlobalInvocationID.x;

    if (mode == 0u) {
        if (i >= count) return;
        float x = pos[i * 14u + 0u];
        float y = pos[i * 14u + 1u];
        float z = pos[i * 14u + 2u];
        float d = zx * x + zy * y + zz * z + tz;
        uint  b = floatBitsToUint(d);
        keys[i] = (b & 0x80000000u) != 0u ? ~b : (b | 0x80000000u);
    } else {
        if (i >= count) return;
        uint ixj = i ^ j;
        if (ixj > i) {
            uint a = indices[i];
            uint b = indices[ixj];
            bool asc  = (i & k) == 0u;
            // STABLE TOTAL ORDER (agent/engine-determinism-argc, 2026-09-20): ties
            // on the depth key are broken by the splat index carried in the
            // permutation itself, so (key, index) pairs are unique for real splats
            // and the fully sorted order is UNIQUE — independent of the
            // permutation entering the sort. The strict key-only compare left
            // equal keys unswapped, so the converged tie arrangement depended on
            // the index buffer's history — and that buffer is re-initialized only
            // when the splat COUNT changes, never on re-upload of the same count:
            // the same buffer posted twice sorted ties differently (measured
            // 2026-09-20: 8/48 replicate frames differed, splat-overlap pixels,
            // max per-pixel delta 3/255). Padding entries all carry index 0 and
            // key 0xFFFFFFFF — indistinguishable from each other (inert: they
            // always sort after every real key, which is strictly smaller, and
            // their mutual order is byte-invisible) and never tied with a real
            // entry. Same stage count, same dispatches: no added passes.
            bool swap = asc ? (keys[a] > keys[b] || (keys[a] == keys[b] && a > b))
                            : (keys[a] < keys[b] || (keys[a] == keys[b] && a < b));
            if (swap) {
                indices[i]   = b;
                indices[ixj] = a;
            }
        }
    }
}
