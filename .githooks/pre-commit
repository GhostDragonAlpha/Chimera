#!/usr/bin/env bash
# Chimera pre-commit — the project's own gates, then shazam's.
#
# WHY THIS LIVES IN THE REPO. `.git/hooks/pre-commit` is owned and rewritten by shazam,
# so a check added there disappears the next time shazam reinstalls. This file is tracked
# in git, survives that, travels to any clone, and DELEGATES to shazam so nothing is lost.
#
# Enabled by:  git config core.hooksPath .githooks
# Bypass:      git commit --no-verify   (and then you own what you shipped)

set -u
root="$(git rev-parse --show-toplevel)"
cd "$root" || exit 1
fail=0

# --- network exposure ------------------------------------------------------
# Three of this project's servers were found answering the whole LAN, none of it a
# decision. See core/bind_guard.py and docs/LOCAL_SERVERS.md.
# Guard on the module's existence: a missing optional gate must not block every commit.
if command -v python >/dev/null 2>&1 && [ -f Chimera/core/bind_guard.py ]; then
  if ! python -m core.bind_guard --staged; then
    fail=1
  fi
fi

# --- objective design method (docs/OBJECTIVE_DESIGN.md) --------------------
# A trainer objective the optimiser can exploit is a bug you find after a retrain cycle.
# Enforce the mechanically-checkable rules on staged objectives. New work must comply;
# the 47 pre-existing satisficers are only checked if you touch them.
# Guard on the module's existence: a missing optional gate must not block every commit.
if command -v python >/dev/null 2>&1 && [ -f Chimera/core/objective_lint.py ]; then
  if ! ( cd Chimera && python -m core.objective_lint --staged ); then
    fail=1
  fi
fi

# --- one-writer rule for the genome library (THE_ORDER #4) -----------------
# recovered_genomes.json has ONE atomic owner (export_genome.save_library). Refuse a
# staged file that writes it directly and would race the owner.
# Guard on the module's existence: a missing optional gate must not block every commit.
if command -v python >/dev/null 2>&1 && [ -f Chimera/core/library_guard.py ]; then
  if ! ( cd Chimera && python -m core.library_guard --staged ); then
    fail=1
  fi
fi

# --- the completeness gate must not rot (docs/THE_FORMULA.md S2b/S7) --------
# DRY is a MEASURED saturation (Chao2 completeness + dry tail), proven every run -- never an
# assertion. If you touch the gate, it must still refuse an incomplete (hand-declared) set.
# A3 PHASE 1: runs the WIRED copy (Chimera/core) -- this hook was silently executing the stale
# ChimeraEngine/core twin via cwd binding, which died when that duplicate set was deduped.
if command -v python >/dev/null 2>&1 && [ -f Chimera/core/saturation.py ]; then
  if ! ( cd Chimera && python -m core.saturation --staged ); then
    fail=1
  fi
fi

# --- perf-guard: slowness is the one failure that never announces itself ----
# Wrong code raises. Slow code returns the CORRECT answer and stays invisible until somebody sits
# through it, so the pull toward the single-threaded readable implementation has no counter-force.
# This is the counter-force. Budgets are declared in ChimeraEngine/perf_witness.py; an entry that
# should be slow declares budget=inf WITH A REASON, the way bind-guard wants `# bind-public:`.
#
# Only runs when engine code is staged -- a docs commit should not pay for a benchmark. Escape
# hatch CHIMERA_SKIP_PERF=1 matches the other gates: it must never be able to trap the operator
# out of committing, only make the slow choice visible.
if command -v python >/dev/null 2>&1 && [ "${CHIMERA_SKIP_PERF:-}" != "1" ]; then
  if git diff --cached --name-only | grep -qE '^ChimeraEngine/.*\.py$'; then
    if ! python ChimeraEngine/perf_witness.py > /tmp/chimera_perf.$$ 2>&1; then
      echo "[perf-guard] REFUSED: a declared performance budget is blown."
      sed -n '/BUDGET(S) BLOWN/,$p' /tmp/chimera_perf.$$ | head -20
      echo "  full report: python ChimeraEngine/perf_witness.py"
      echo "  if the entry SHOULD be slow, give it budget=inf and say WHY in perf_witness.py"
      echo "  override once with: CHIMERA_SKIP_PERF=1 git commit ..."
      fail=1
    else
      echo "[perf-guard] PASS: every declared performance budget met."
    fi
    rm -f /tmp/chimera_perf.$$
  fi
fi

# --- doc-guard: PLAN.md must not silently shrink ----------------------------
# An agent session died mid-write and left SPIACE_RPG_PLAN.md at 0 lines; recovery
# needed git history (AGENT_PROTOCOL.md rule 3). Refuse a staged PLAN.md losing
# >50 lines vs HEAD. Deliberate shrink: CHIMERA_ALLOW_PLAN_SHRINK=1 and say why
# in the commit message — same escape-hatch shape as perf-guard.
PLAN=ChimeraEngine/engine/SPIACE_RPG_PLAN.md
if git diff --cached --name-only | grep -qx "$PLAN"; then
  read -r added deleted _ < <(git diff --cached --numstat -- "$PLAN")
  added=${added:-0}; deleted=${deleted:-0}
  lost=$((deleted - added))
  if [ "$lost" -gt 50 ] && [ "${CHIMERA_ALLOW_PLAN_SHRINK:-}" != "1" ]; then
    echo "[doc-guard] REFUSED: $PLAN loses $lost lines (wipe protection)."
    echo "  if deliberate: CHIMERA_ALLOW_PLAN_SHRINK=1 git commit ... and say why in the message"
    fail=1
  else
    echo "[doc-guard] PASS: PLAN.md intact."
  fi
fi

# --- doc-guard: the method must not drift from the tooling ------------------
# A doc that duplicates a fact drifts from it. The broken-pointer linter refuses
# any reference (in staged files) to a tool or file that does not exist on disk,
# and validates .roomodes structure. Only staged files are checked, so pre-existing
# prose is not a wall -- but you cannot COMMIT a new broken pointer.
if command -v python >/dev/null 2>&1 && [ -f tools/doc_lint.py ]; then
  if [ "${CHIMERA_SKIP_DOCLINT:-}" != "1" ]; then
    if ! python tools/doc_lint.py --staged; then
      echo "  fix or: git commit --no-verify (and then you own the drift)"
      fail=1
    fi
  fi
fi

# --- delegate to shazam ----------------------------------------------------
if [ -x .git/hooks/pre-commit ] && [ "${CHIMERA_SKIP_SHAZAM:-}" != "1" ]; then
  .git/hooks/pre-commit "$@" || fail=1
fi

exit $fail
