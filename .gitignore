# ChimeraEngine/output/ is ALL generated: projected appearance-messenger renders, test
# mocks, and the recovered junk PNG that once clobbered __init__.py. Runtime artifacts,
# never source -- ignore the whole directory so no future render/mock can slip into git.
ChimeraEngine/output/

# baked splat buffers -- regenerate with: python ChimeraEngine/bake_splats.py <term>
web/renderer/data/*.bin

# Downloaded reference corpora -- large, and not ours to redistribute
external/

# growth artifacts (regenerated by story/grow.py)
story/**/__pycache__/

# render artifacts (regenerated; kept on disk, out of the tree)
/*.gif
/*.png

# 4D span sheets (regenerated by ChimeraEngine/span.py)
/span_*.png

# OSF normative gait workbooks (Van Criekinge 2023, CC BY 4.0) -- 20 MB of spreadsheet that
# `tools/ingest_gait_osf.py` re-fetches on demand. The EXTRACTED table it produces,
# story/data/gait_normative.json, IS committed: that is what the membranes read.
research_references/human/gait_osf/

# Human acquisition sweep 2026-07-31 (see research_references/human/ACQUISITION_PLAN.md):
# bulk raw downloads stay out of git; only extracted story/data/*.json tables get committed.
# Small canonical measured functions (CVRL CSVs, KBs) ARE committed -- the membranes read them.
research_references/human/mocap/cmu_full/
research_references/human/balance/
research_references/human/jump/
research_references/human/partial_g/
research_references/human/eva/
research_references/human/grip/
research_references/human/skin_friction/
research_references/optics/refractiveindex.info-database/
research_references/optics/*.zip

# Generated takes and their clay references -- regenerated on demand by tools/seedance_probe.py,
# and the mp4s are outputs of a paid API rather than source. The JSON they produce (score, hull,
# material) IS the result and is committed alongside the tools.
clay_exports/

# Scratch. `.tmp/` is a throwaway scratch dir (a saved HTML page, debug dumps); nothing in it is
# source and nothing reads it. Kept out of the tree so `git status` stays a true signal --
# a repo whose status is never clean is a repo where a real stray file is invisible.
.tmp/

# Phase N build artifact (rebuilt by test_native.py)
ChimeraEngine/native/ca_core.exe

# Agent scratch quarantine (AGENT_PROTOCOL.md rule 5): probe scripts, logs, and
# dumps from agent sessions live here or nowhere. Loose _-prefixed scratch in
# engine/ is also ignored so `git status` stays a true signal.
ChimeraEngine/engine/scratch/
ChimeraEngine/engine/_*.py
ChimeraEngine/engine/_*.txt
ChimeraEngine/engine/_*.json

# native viewer build artifacts (sources + vendored 3rd party ARE tracked)
ChimeraEngine/native/ChimeraEngine.exe
ChimeraEngine/native/wgpu_native.dll

# relay wire logs (per-port, unbounded while a session runs — the test oracle
# reads fresh ones; long-session logs are gigabytes and never an artifact)
ChimeraEngine/native/native_stream*.log
ChimeraEngine/native/_relay_dbg.log
ChimeraEngine/native/nul

