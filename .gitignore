# ─── Repo-hygiene additions (2026-07-09) ─────────────────────────────────────
# node_modules at ANY depth (this is a Python/UE repo — every node_modules is a
# dependency artifact, never source). Supersedes the path-specific rules above.
node_modules/

# Stray root-level npm scaffolding (a 3-line playwright stub; Pi's own deps live
# in .pi/npm/package.json). Leading slash = repo root only.
/package.json
/package-lock.json

# Stale DUPLICATE Pi extensions dir — auto-created when Pi was once launched from
# Chimera/ instead of the repo root. The real extensions live in /.pi/extensions/.
Chimera/.pi/

# AI model weights + HuggingFace download caches — far too large for git.
# Qwen2Audio/ alone is ~6 GB of interrupted .incomplete downloads. These are
# fetched/regenerated, never source; committing them would bloat history forever.
Chimera/Content/AIModels/
Chimera/Content/Qwen2Audio/

# Voice/STT test capture artifacts (regenerated per test run)
Chimera/test_audio.wav
Chimera/test_audio.wav.txt

# Gitignore the world-model data store (SQLite DB + WAL) — it is data, regenerated
Chimera/docs/world/

# CAPCOM operator inbox — machine-local operator scratch, auto-created by
# `python -m core.capcom brief`. Notes are ephemeral/local, not repo content.
Chimera/docs/OPERATOR_INBOX.md

Chimera/scratch/

# MuJoCo writes this next to the process; it is engine spew, not source.
MUJOCO_LOG.TXT

