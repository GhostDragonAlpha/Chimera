# Generated projects and build outputs
GeneratedProjects/
Chimera/Intermediate/
Chimera/Saved/
Chimera/Binaries/
Chimera/DerivedDataCache/
Chimera/.vs/
Chimera/Build/
Chimera/Plugins/**/Binaries/
Chimera/Plugins/**/Intermediate/

# Logs and temp files
*.log
*.sarif
$null

# Test output files
tdd_pipeline_output*.txt
demo_output.txt
deleted_files_summary.txt
diff_output.txt
validation_output.txt

# Large binaries
antlr-4.13.2-complete.jar

# IDE and editor files
.vscode/
.idea/
*.sln
*.slnx
*.swp
*.swo
*~

# Node modules (for .kilo)
.kilo/node_modules/

# Python cache
__pycache__/
*.pyc
*.pyo

# Stale session artifacts (never commit)
-p/
Test message only -- no image provided/

# Archived one-off scripts
session_records/

# Local clone of the graphify tool (own git repo — would embed a broken gitlink)
Chimera/tools/graphify/

# Playwright MCP session artifacts (page snapshots/screenshots)
.playwright-mcp/

# Graphify tool output (belongs next to the tool, never in source trees)
graphify-out/

# Generated/Content subdirectories (Niagara, Effects, etc. — procedurally generated by UE)
Chimera/Content/Chimera/

# Corrupted/malformed directories (non-UTF8 names)
Chimera/E\*/

# Node modules cache (Chimera-local npm; use .pi/npm instead for Pi)
Chimera/node_modules/
Chimera/package.json
Chimera/package-lock.json

# UBT-generated clangd database (regenerate via UBT -Mode=GenerateProjectFiles -VSCode)
Chimera/compile_commands.json

# Test/validation outputs (generated per run)
Chimera/ValidationReports/
test_report_*.json

# One-off LM/context scripts (not part of the core pipeline)
Chimera/context_compressor.py
Chimera/lm.bat
Chimera/lm.ps1
Chimera/LM-Chat.bat
Chimera/LM-Chat.py
Chimera/LM-Ask.bat
Chimera/LM-README.txt
Chimera/mcp_context_server.py
Chimera/start-context-compression.bat
