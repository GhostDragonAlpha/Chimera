+    def test_camera_speed_bounded_by_twice_animal_speed(self):
+        class Walker:
+            def __init__(self):
+                self.t = 0.0
+                self.p = (3.0, 0.0, 0.0)     # starts outside the trunk ring
+
+            def read(self):
+                self.t += 0.05
+                x, _y, z = self.p
+                self.p = (x + 0.02, 0.0, z + 0.01)
+                return fc.AnchorReading(self.p, (0.02, 0.01), self.t)
