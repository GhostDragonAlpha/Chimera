+                       {"resource_id": "e", "owner": None, "generation": 0}):
+            with self.assertRaises(LedgerRefusal) as ctx:
+                self.led.acquire(now_ms=0, **kwargs)
+            self.assertEqual(ctx.exception.code, "ledger_bad_id")
