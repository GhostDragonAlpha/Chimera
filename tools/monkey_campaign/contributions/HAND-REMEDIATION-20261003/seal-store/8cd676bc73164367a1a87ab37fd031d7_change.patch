+def chain_refuses(tip, joint, map_primary):
+    st = map_primary["per_tip_structure"][tip]
+    if joint in set(st["off_chain_structural_zero"]):
+        return dict(fired=True, reason="off_chain_structural_zero")
+    if joint in set(st["exact_zero_arm_on_chain"]):
+        return dict(fired=True, reason="exact_zero_arm_on_chain")
+    return dict(fired=False, reason=None)
