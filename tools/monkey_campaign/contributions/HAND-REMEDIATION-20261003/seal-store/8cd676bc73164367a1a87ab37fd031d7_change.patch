+# ---------------------------------------------------------------------------
+# the capacity classification (the declared outcome space; counts close)
+# ---------------------------------------------------------------------------
+def classify_capacity(taus, cap=CAP_N_M):
+    if any(t is None or not math.isfinite(t) for t in taus.values()):
+        return ("ARM_NONFINITE_REFUSED", None, None)
+    binding = None
+    worst = -1.0
+    for jn, t in taus.items():
+        if abs(t) > worst:
+            worst = abs(t)
+            binding = jn
+    if worst > cap:
+        return ("CAP_EXCEEDED", binding, worst)
+    return ("CAP_SATISFIED", binding, worst)
+
