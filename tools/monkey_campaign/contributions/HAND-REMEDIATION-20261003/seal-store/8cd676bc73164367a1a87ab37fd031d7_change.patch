+# run_stage2_capacity.py - HAND-REMEDIATION-20261003 R1 STAGE 2 (released by
+# the Lieutenant on the pinned stage-2 prereg 662362e3 / bytes 2d7ff417...).
+#
+# Run class `stage2_capacity`. Consumes the FINAL survivor set (354: 314
+# q_c + 40 q_zero) from the raised-cap receipt (4df5f480...), pinned
+# in-package. tau_j = (J(q)^T f)_j at the actuator-map revision-2
+# conventions (identity-gated against CANDIDATE:PRIMARY); cap basis 0.8875
+# N*m (RECORDED, never decisive). The declared outcome space
+# {CAP_SATISFIED, CAP_EXCEEDED, ARM_NONFINITE_REFUSED} closes over 354 with
+# exact arithmetic. THE NOT-CLAIMS SECTION OF THE PINNED PREREG GOVERNS
+# EVERY SENTENCE OF EVERY REPORT: no "the hand can hold" phrasing exists
+# anywhere in this pipeline; a CAP_SATISFIED verdict at the pad's <= 0.23 N
+# forces is ladder consistency only.
+import hashlib
+import json
+import os
+import sys
+import time
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, HERE)
+import instrument_v2 as iv    # noqa: E402  sealed, unmodified
+import grasp_screen as gs     # noqa: E402  sealed, unmodified
+import vpl1_pad as vp         # noqa: E402  stage-1 pad module, unmodified
+import stage2_capacity as s2  # noqa: E402  the stage-2 module (this package)
+
+OUT_NAME_RECEIPT = "stage2_capacity_receipt.json"
+OUT_NAME_REPORT = "stage2_capacity_report.txt"
+
+
+def emit(line=""):
+    gs._report.append(line)
+    print(line, flush=True)
+
+
+def sha_of(path):
+    with open(path, "rb") as fh:
+        return hashlib.sha256(fh.read()).hexdigest()
+
+
+def canonical(x):
+    return json.dumps(x, indent=1, sort_keys=True)
+
+
+def pipeline():
+    _t_start = time.time()
+    # ---- pinned identities (refused on drift) ----
+    pins = {
+        "R1_STAGE2_PREREG.md": s2.STAGE2_PREREG_SHA,
+        s2.RAISED_CAP_RECEIPT_NAME: s2.RAISED_CAP_RECEIPT_SHA,
+        s2.JACOBIAN_MAP_NAME: s2.JACOBIAN_MAP_SHA,
+        "PREREGISTRATION_R1_PAD_LAYER.md": s2.PREREG_R1_SHA,
+        "R1_AMENDMENT_1.md": s2.AMENDMENT_1_SHA,
+        "R1_AMENDMENT_2.md": s2.AMENDMENT_2_SHA,
+        "instrument_v2.py": s2.INSTRUMENT_SHA,
+        "grasp_screen.py": s2.SCREEN_SHA,
+        "vpl1_pad.py": ("54af4a49ce57736cf0d90fe2a5d57ea98dd24d568efcae63"
+                        "5b8e20479575794e"),
+    }
+    for fname, expect in sorted(pins.items()):
+        got = sha_of(os.path.join(HERE, fname))
+        if got != expect:
+            iv.refuse("input_pin_mismatch", "%s %s" % (fname, got))
+    emit("=" * 78)
+    emit("GATE. all %d in-package pins MATCH (stage-2 prereg %s / raised-"
+         "cap receipt %s / jacobian map %s)."
+         % (len(pins), s2.STAGE2_PREREG_SHA[:16],
