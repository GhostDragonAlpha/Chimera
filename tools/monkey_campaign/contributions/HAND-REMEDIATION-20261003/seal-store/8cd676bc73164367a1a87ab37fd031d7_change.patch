+def map_identity_gate(model, map_primary):
+    """Two gates: (1) the map's PRIMARY jacobian columns are reproduced by
+    the column law from the map's OWN joint_records + tip positions;
+    (2) the sealed FK at the PRIMARY q reproduces the map's joint_records
+    (world origins + axes). Any miss = jacobian_identity_failed."""
+    bodies = model[0]
+    tips = map_primary["tip_positions_m"]
+    recs = {jn: (d["origin"], d["axis"])
+            for jn, d in map_primary["joint_records"].items()}
+    diffs = []
+    # gate 1: the column law vs the map's columns
+    for tip, cols in map_primary["jacobian_columns"].items():
+        mine = columns_from_records(recs, tips[tip], cols.keys())
+        for jn, v in cols.items():
+            d = max(abs(mine[jn][k] - v[k]) for k in range(3))
+            if d > 1e-12:
+                diffs.append("col %s/%s %.3e" % (tip, jn, d))
+    # gate 2: the sealed FK vs the map's joint_records
+    q_map = dict(map_primary["q"])
+    positions, rotations, fk_recs = iv.fk_frames(
+        bodies, model[2], q_map, wrist=tuple(map_primary["wrist"]))
+    fk = {jn: (origin, axis) for (jn, _b, origin, axis) in fk_recs}
+    for jn, (origin, axis) in recs.items():
+        fo, fa = fk[jn]
+        d = max(max(abs(fo[k] - origin[k]) for k in range(3)),
+                max(abs(fa[k] - axis[k]) for k in range(3)))
+        if d > 1e-9:
+            diffs.append("rec %s %.3e" % (jn, d))
+    return dict(ok=not diffs, diffs=diffs[:10],
+                columns=len(map_primary["jacobian_columns"]),
+                joints=len(recs))
+
+
+def zero_joint_records(model):
+    """The certified joint records (world origin + world axis) at q = 0 via
+    the sealed FK (the map's machinery at q = 0; the map has no zero-
+    posture record - declared in the pinned prereg's method)."""
+    zero = {jn: 0.0 for jn in model[1]}
+    _pos, _rot, recs = iv.fk_frames(model[0], model[2], zero)
+    return {jn: (origin, axis) for (jn, _b, origin, axis) in recs}
