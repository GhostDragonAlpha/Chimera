+# ---------------------------------------------------------------------------
+# the jacobian machinery (the map's own law; gated against the map)
+# ---------------------------------------------------------------------------
+def columns_from_records(joint_records, tip_pos, joints):
+    """J column per joint = (tip_pos - origin_j) x axis_j (the CC5 law at
+    the declared application point)."""
+    cols = {}
+    for jn in joints:
+        origin, axis = joint_records[jn]
+        arm = iv.sub(tip_pos, origin)
+        cols[jn] = iv.cross(arm, axis)
+    return cols
+
