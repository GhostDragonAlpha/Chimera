+def load_sealed_module():
+    """Import the SEALED G04 module after asserting its bytes (the module's
+    own load_interface/load_trunk_geometry assert the interface + the trunk
+    bytes; the driver asserts the module bytes)."""
+    got = sha_of(GRIP_PATH)
+    if got != G04_GRIP_SHA:
+        raise ValueError("input_pin_drift:grip_contact:" + got)
+    spec = importlib.util.spec_from_file_location("g04_sealed_grip",
+                                                  GRIP_PATH)
+    mod = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(mod)
+    return mod
