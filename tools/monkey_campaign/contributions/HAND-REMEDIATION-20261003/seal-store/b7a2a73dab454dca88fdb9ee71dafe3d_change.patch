+def hold_release_verdicts(rows, share_kg, win_release_scale):
+    """The declared outcome space, read from the sealed rows. The module's
+    own require()s (jn==P window, stick arrest, the ledger identity, the
+    release zero bars, the free-fall/displacement recursions) have ALREADY
+    bitten if the run completed - a completed run is a sealed-invariants
+    run. The verdicts classify the phases per channel."""
+    hold = {}
+    release = {}
+    hold_ticks = [r for r in rows if r["phase"] == "hold"]
+    release_ticks = [r for r in rows if r["phase"] == "release"]
+    for c in range(3):
+        hold_modes = [r["pads"][c]["mode"] for r in hold_ticks]
+        hold[c] = ("HOLD_SUSTAINED"
+                   if hold_modes and all(m == "stick" for m in hold_modes)
+                   else "HOLD_SLIP")
+        # the sealed release bar: share_kg * WIN_RELEASE_SCALE (the
+        # module's own window; a stricter invented bar would be a silent
+        # threshold change)
+        bar = share_kg * win_release_scale
+        zero_bar = all(
+            abs(r["pads"][c]["jn_sum_Ns"]) <= bar
+            and abs(r["pads"][c]["jt_sum_Ns"]) <= bar
+            for r in release_ticks)
+        release[c] = ("RELEASE_SEPARATED" if zero_bar
+                      else "RELEASE_RESIDUAL")
+    return hold, release
