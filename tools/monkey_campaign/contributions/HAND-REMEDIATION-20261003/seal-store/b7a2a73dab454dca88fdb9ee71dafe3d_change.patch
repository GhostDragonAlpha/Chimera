+def png_strip(path, hexhash):
+    """The minimal state-binding capture (the prereg's capture-bound
+    definition): a 128x16 PNG whose pixel strip encodes the state hash
+    (2 px per hex char, dark bit / light bit). Stdlib zlib+struct;
+    deterministic; byte-reproducible."""
+    width, height = 128, 16
+    top = bytearray([255] * (width * 3))
+    for i in range(64):
+        ch = hexhash[:64].encode("ascii")[i]
+        bit = ch & 1
+        for dx in range(2):
+            x = i * 2 + dx
+            v = 20 if bit else 235
+            top[x * 3] = v
+            top[x * 3 + 1] = v
+            top[x * 3 + 2] = v
+    body = bytearray()
+    for y in range(height):
+        body.append(0)
+        body.extend(top if y == 0 else bytearray([240] * (width * 3)))
+
+    def chunk(tag, data):
+        c = tag + data
+        return (struct.pack(">I", len(data)) + c
+                + struct.pack(">I", zlib.crc32(c) & 0xFFFFFFFF))
+    png = (b"\x89PNG\r\n\x1a\n"
+           + chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 2,
+                                        0, 0, 0))
+           + chunk(b"IDAT", zlib.compress(bytes(body), 9))
+           + chunk(b"IEND", b""))
+    with open(path, "wb") as fh:
+        fh.write(png)
+    return hashlib.sha256(png).hexdigest()
+
+
+def gate_strip(path, state_hash):
+    """The capture gate: the frame's pixel strip must decode to the
+    recomputed state hash (the state binding IS the gate for a
+    state-binding capture; a frame that does not bind its state FAILS)."""
+    raw = open(path, "rb").read()
+    ihdr_at = raw.find(b"IHDR")
+    w = int.from_bytes(raw[ihdr_at + 4:ihdr_at + 8], "big")
+    idat_at = raw.find(b"IDAT")
+    idat_len = int.from_bytes(raw[idat_at - 4:idat_at], "big")
+    dec = zlib.decompress(raw[idat_at + 4:idat_at + 4 + idat_len])
+    top = dec[1:1 + w * 3]
+    got = ""
+    for i in range(64):
+        x = i * 2
+        v = top[x * 3]
+        got += "1" if v < 128 else "0"
+    ok = len(got) == 64
+    return dict(frame_ok=bool(ok), strip_bits=got)
+
+
+def run_schedule_pair(mod, lc, geom):
+    return run_schedule(mod, lc, geom, "stage5_mid_band", mod.PAD_MU_S,
+                        mod.PAD_MU_K)
