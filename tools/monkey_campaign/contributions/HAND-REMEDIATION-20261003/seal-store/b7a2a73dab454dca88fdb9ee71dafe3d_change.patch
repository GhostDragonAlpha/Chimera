+                    "the NAMED-UNMET RUNG. The transactional window "
+                    "65a23111 is referenced, never depended on."),
+        governing_labels={"P1": ERRATUM_LABEL},
+        corrected_ladder_label=CORRECTED_LADDER_LABEL,
+        coexistence_note=COEXISTENCE_NOTE,
+        named_unmet_rung=("the VPL-1 native compliant contact layer: a "
