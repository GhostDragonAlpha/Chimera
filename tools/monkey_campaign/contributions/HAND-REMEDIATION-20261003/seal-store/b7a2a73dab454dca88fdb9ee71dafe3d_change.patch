+def run_schedule(mod, lc, geom, scenario_id, mu_s, mu_k,
+                 reading_override=None, n_override=None):
+    """The sealed schedule (the module's OWN tick engine; the driver adds
+    only the signed-channel reading). The reading/n default to the sealed
+    mid-band corridor (6.15 kg, n=3); the overrides exist ONLY for the
+    sealed ZERO_MU_CONTROL case (its own reading + count)."""
+    reading = reading_override if reading_override is not None else 6.15
+    n = n_override if n_override is not None else 3
+    header, rows = mod.run_scenario(
+        lc, geom, reading, n, mu_s=mu_s, mu_k=mu_k,
+        press_ns=mod.PRESS_JN_NS, hold_ticks=mod.HOLD_TICKS,
+        release_ticks=mod.RELEASE_TICKS, scenario_id=scenario_id)
+    signed = []
+    for row in rows:
+        rec = dict(tick=row["tick"], phase=row["phase"],
+                   channels=[],
+                   ledger_reciprocity_residual=repr(
+                       row["ledger"]["reciprocity_residual"]))
+        for pad in row["pads"]:
+            rec["channels"].append(dict(
+                pad=pad["pad"], jn_Ns_signed=pad["jn_sum_Ns"],
+                jt_Ns_signed=pad["jt_sum_Ns"], mode=pad["mode"],
+                vt_post_mps=pad["vt_post_mps"],
+                disp_tick_m_signed=pad["disp_tick_m"]))
+        signed.append(rec)
+    return header, rows, signed
+
