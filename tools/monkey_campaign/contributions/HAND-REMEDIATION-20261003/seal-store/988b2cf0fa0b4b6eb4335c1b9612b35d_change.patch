+# run_stage4_grasp.py - HAND-REMEDIATION-20261003 R1 STAGE 4 (released by
+# the Lieutenant on the pinned stage-4 prereg 79b26394 / bytes 4438c4d7...;
+# the declared-model scope RATIFIED).
+#
+# Run class `stage4_supported_grasp`. The 4x5 (reading, n) law grid: 20
+# static outcomes + 20 transfer outcomes (16 defined + 4 explicitly named
+# TRANSFER_UNDEFINED_AT_N1 cells), each against the FROZEN partition
+# below. THE NOT-CLAIMS SECTION OF THE PINNED PREREG GOVERNS EVERY
+# SENTENCE: this stage demonstrates NO PHYSICAL HOLD; "supported" means
+# the frozen law forms close or fail at declared inputs; the same-hands
+# debt stands; TC-8 = 0/8; the goal stays open.
+import hashlib
+import json
+import os
+import sys
+import time
+
