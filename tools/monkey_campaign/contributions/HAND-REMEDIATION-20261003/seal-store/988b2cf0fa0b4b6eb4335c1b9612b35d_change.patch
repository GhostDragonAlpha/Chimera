+# stage4_grasp.py - HAND-REMEDIATION-20261003 R1 STAGE 4: the supported-
+# grasp rung at DECLARED-MODEL SCOPE - the G01 hold/transfer law forms
+# evaluated as CONDITIONAL-CALCULATIONS at declared inputs, per the pinned
+# stage-4 prereg (79b26394 / 4438c4d7...). Stdlib only; deterministic;
+# serial. NO survivor-set geometry is consumed (the capacity stage owns
+# the placements; stage 4 owns the (reading, n) law grid).
+#
+# THE NOT-CLAIMS (the pinned prereg section 5, governing every reading):
+# THIS STAGE DEMONSTRATES NO PHYSICAL HOLD. "Supported" here means: the
+# frozen law forms CLOSE or FAIL at declared inputs, per reading, with
+# every threshold a CONDITIONAL-CALCULATION. The same-hands debt stands
+# (the 0.049 kg anatomical hand vs the 10.038 kg scene line); the support
+# routes through the declared press channel; x_press is ABSENT (TC-8
+# ports 0/8); the 60 N/channel press is a DECLARED fixture, never an
+# actuator qualification. The playable-monkey goal stays open.
+
+import json
+import math
+import os
+import sys
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, HERE)
+
+# ---------------------------------------------------------------------------
+# pinned identities (refused on drift)
+# ---------------------------------------------------------------------------
+STAGE4_PREREG_SHA = ("4438c4d76c2d904d08a09eb1f29db55b25bdccaeb399f2d8db26"
+                     "ad0d78e5dfc1")
+
+# ---------------------------------------------------------------------------
+# the frozen inputs (prereg section 1; NEVER tuned post-run)
+# ---------------------------------------------------------------------------
+READINGS = [
+    # (mass label, kg, W_N frozen from the K-spec's quoted std-g lines)
+    ("5.4", 5.4, 52.95591),
+    ("6.15", 6.15, 60.3108975),
+    ("6.9", 6.9, 67.665885),
+    ("10.037998", 10.037998, 98.4391330867),
+]
+NS = (1, 2, 3, 4, 5)
+CEILING_N = 60.0          # A3: the DECLARED fixture press ceiling/channel
+MU_S = 0.6                # A5: the NAMED placeholder
+JN_N_S = 0.3              # A3: the per-tick press impulse
+DT_S = 5.0e-3             # A3: the scene tick
+TRANSFER_CAP_N_S = MU_S * JN_N_S   # 0.18 N*s per channel (A6)
+
+# the recorded debt row (the capacity stage's law-form-vs-cap reading),
+# recorded BESIDE the law-form cells so the two readings of "exceeded"
+# cannot be conflated (the pinned prereg S4-P4)
+DEBT_ROW = dict(source="the capacity stage / actuator-map frontier",
+                quantity="joint torque tau at cmc_abduction under the "
+                         "DECLARED 60 N press",
+                value_n_m=1.391986171, cap_n_m=0.8875,
+                reading="a TORQUE-vs-CAP exceeded: the press channel has "
+                        "no actuator derivation (TC-8 0/8)")
+
+ERRATUM_LABEL = ("P1 partially falsified as literally frozen "
+                 "(534+292+128, identical at the raised cap) - PR #335, "
+                 "astra 2944ea90; the governing label for every downstream "
+                 "citation of the stage-1/raised-cap P1")
+
+
+def sha_of(path):
+    with open(path, "rb") as fh:
+        import hashlib
+        return hashlib.sha256(fh.read()).hexdigest()
+
+
+def canonical(x):
+    return json.dumps(x, indent=1, sort_keys=True)
+
+
+# ---------------------------------------------------------------------------
+# the law forms (A6 + the DERIVATION section 8.2 instance list)
+# ---------------------------------------------------------------------------
+def static_law(w_n, n, mu_s=MU_S, ceiling=CEILING_N):
+    """P_req = W/(n*mu_s) vs the declared ceiling."""
+    p = w_n / (n * mu_s)
+    return dict(quantity="P_req_N", value=p, cls=("HOLD_CLOSES" if p
+                                                  <= ceiling
+                                                  else "HOLD_EXCEEDED"),
+                code_path="static_law: W/(n*mu_s) vs the declared 60 N "
+                          "ceiling (A3/A6)")
+
+
+def transfer_law(w_n, n, dt=DT_S, cap=TRANSFER_CAP_N_S):
+    """(m*g*DT)/(n-1) vs mu_s*jn = 0.18 N*s; n = 1 is the EXPLICIT named
+    undefined class (the institutionalized absorbed-band lesson)."""
+    if n == 1:
+        return dict(quantity="transfer_N_s", value=None,
+                    cls="TRANSFER_UNDEFINED_AT_N1",
+                    code_path="transfer_law: (m*g*DT)/(n-1) - division by "
+                              "zero at n=1; the undefined cell is NAMED, "
+                              "never dropped")
+    v = (w_n * dt) / (n - 1)
+    return dict(quantity="transfer_N_s", value=v,
+                cls=("TRANSFER_CLOSES" if v <= cap else
+                     "TRANSFER_EXCEEDED"),
+                code_path="transfer_law: (m*g*DT)/(n-1) vs mu_s*jn = "
+                          "0.18 N*s (A3/A6)")
+
+
+def mu0_law(w_n, n, mu=0.0):
+    """The mu=0 bite (retained from stage 3, re-armed at the G01 forms):
+    the static form at mu = 0 diverges -> NON_CLOSING."""
+    if mu <= 0.0:
+        return dict(quantity="P_req_N", value=None, cls="NON_CLOSING",
+                    code_path="static_law at mu=0: the closure diverges "
+                              "(A6 law form)")
+    return static_law(w_n, n, mu)
