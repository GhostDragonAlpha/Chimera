+
+def eval_p1(rec, qdump1: Path) -> dict:
+    """P1 ANCHOR IDENTITY, EXTENDED FLOOR: the W03I instrument reproduces
+    the sealed W03 anchors exactly. TRACE-REPRODUCTION EVIDENCE AT RECORDED
+    PRECISION; NOT a non-perturbation proof (no paired test exists; the
+    assurance class = the pure-read line manifest + this identity +
+    two-pass determinism)."""
+    checks = {
+        "stdout_sha": rec["stdout_sha256"] == SEALED_STDOUT_SHA,
+        "stderr_sha": rec["stderr_sha256"] == SEALED_STDERR_SHA,
+        "qdump1_sha": rec["qdump1_sha256"] == SEALED_QDUMP_SHA,
+        "qdump2_sha": rec["qdump2_sha256"] == SEALED_QDUMP_SHA,
+    }
+    rows = [json.loads(l) for l in qdump1.open(encoding="utf-8")]
+    dx = rows[-1]["q"][3] - rows[0]["q"][3]
+    dy = rows[-1]["q"][4] - rows[0]["q"][4]
+    checks["ticks_302"] = len(rows) == SEALED_TICKS
+    checks["dx_exact"] = (dx == SEALED_DX)
+    checks["dy_exact"] = (dy == SEALED_DY)
+    note = next((m for m in rec["summary"].get("measured", [])
+                 if m.startswith("WALK refused_tick=")), "")
+    checks["refused_note"] = note == (
+        f"WALK refused_tick={SEALED_TICKS} "
+        f"worst_ledger_J={SEALED_LEDGER_J}")
+    return {"checks": checks, "dx": dx, "dy": dy, "walk_note": note,
+            "scoping": "anchor-exact trace reproduction; NOT a "
+                       "non-perturbation proof; no paired test",
+            "pass": all(checks.values())}
+
+
+def eval_p2(rows) -> dict:
+    """P2 SIGNED TELEMETRY COMPLETENESS: the full v2 schema on every
+    window tick, finite; structurally-zero channels named."""
+    keys = ("p", "cg", "fx", "fy", "fz", "gen3", "ifx", "ify", "ifz",
+            "gen3i", "gbe", "dmp", "act_imp", "p_contact", "p_stop",
+            "stop_imp", "igen", "pcorr_dp", "cw_contact_J", "cw_stop_J",
+            "constraint_work_J", "poscorr", "substeps", "adv_calls")
+    missing, nonfinite = [], []
+    zero_channels = {k: 0 for k in keys}
+    bad_sub = []
+    n = 0
+    for r in rows:
+        if not (WALK_LO <= r["tick"] <= WALK_HI):
+            continue
+        n += 1
+        sg = r.get("signed")
+        if sg is None:
+            missing.append({"tick": r["tick"], "what": "signed block"})
+            continue
+        if len(sg.get("substeps", [])) != 4:
+            bad_sub.append({"tick": r["tick"],
+                            "rows": len(sg.get("substeps", []))})
+        for k in keys:
+            if k not in sg:
+                missing.append({"tick": r["tick"], "what": k})
+                continue
+            v = sg[k]
+            vals = v if isinstance(v, list) else ([v] if isinstance(v, (int, float)) else [])
+            nums = [x for x in vals if isinstance(x, (int, float))]
+            if nums and all(abs(x) <= 1e-300 for x in nums) and k not in (
+                    "poscorr", "substeps", "adv_calls"):
+                zero_channels[k] += 1
+            for x in nums:
+                if isinstance(x, float) and (x != x or abs(x) == float("inf")):
+                    nonfinite.append({"tick": r["tick"], "what": k})
+                    break
+    return {"window_ticks": n, "missing": missing[:20],
+            "missing_count": len(missing), "nonfinite": nonfinite[:20],
+            "substep_rows_bad": bad_sub[:20],
+            "substep_rows_bad_count": len(bad_sub),
+            "structurally_zero_ticks": {k: v for k, v in zero_channels.items()
+                                        if v},
+            "pass": (n == (WALK_HI - WALK_LO + 1) and not missing
+                     and not nonfinite and not bad_sub)}
+
+
+def _p3_world_residual(b_row, a_row) -> float:
+    """The world-space companion identity for one transition a->b (N*s on
+    both sides): m*delta(COM_east) - (sum fx + sum ifx + the remaining
+    channels' e3 components). p3 == m*v_COM,east, so this is the SAME
+    identity as the generalized form at coordinate 3, expressed through
+    the signed world tangent sums -- and it is the sign-sensitive form the
+    P10 mutant must break."""
+    sg_a, sg_b = a_row["signed"], b_row["signed"]
+    m = b_row["support"]["mass_kg"]
+    lhs = m * (b_row["support"]["east"] - a_row["support"]["east"])
+    fx = sum(sg_b["fx"]) + sum(sg_b["ifx"])
+    e3 = (sg_b["p_contact"][3] + sg_b["p_stop"][3] + sg_b["gbe"][3]
+          + sg_b["dmp"][3] + sg_b["act_imp"][3] + sg_b["pcorr_dp"][3])
+    return lhs - (fx + e3)
+
+
+def _p3_residual(sg_b, sg_a) -> tuple:
+    """Per-coordinate residual for one tick transition a->b (channels from
+    b's signed block; the impulses applied DURING tick b)."""
+    pa, pb = sg_a["p"], sg_b["p"]
+    n = len(pa)
+    ch = []
+    for i in range(n):
+        c = (sg_b["cg"][i] + sg_b["p_contact"][i] + sg_b["p_stop"][i]
+             + sg_b["gbe"][i] + sg_b["dmp"][i] + sg_b["act_imp"][i]
+             + sg_b["pcorr_dp"][i])
+        ig = 0.0
+        igs = sg_b["igen"]
+        np_pts = len(igs) // n
+        for k in range(np_pts):
+            ig += igs[k * n + i]
+        ch.append(c + ig)
+    return [(pb[i] - pa[i]) - ch[i] for i in range(n)]
+
+
+def eval_p3_signed(rows) -> dict:
+    """P3-SIGNED PER-TICK ATTRIBUTION (the honest either-way):
+    delta_p_i(t) - (cg+igen+p_contact+p_stop+gbe+dmp+act_imp+pcorr_dp)[i]
+    within P3_WINDOW_NS on EVERY window transition, EVERY coordinate.
+    Window [60,300) transitions -- the corrected-identity convention,
+    NOT WIDENED (Lieutenant slot answer)."""
+    by = {r["tick"]: r for r in rows}
+    worst_i, worst_v = -1, -1e30
+    worst3 = -1e30
+    worst_w = -1e30
+    viols = []
+    total = 0
+    cg_fx_dev = 0.0
+    for a in rows:
+        t = a["tick"]
+        if not (WALK_LO <= t < WALK_HI):
+            continue
+        b = by.get(t + 1)
+        if b is None:
+            continue
+        sg_a, sg_b = a["signed"], b["signed"]
+        if "igen" not in sg_b:
+            continue
+        total += 1
+        res = _p3_residual(sg_b, sg_a)
+        rw = _p3_world_residual(b, a)
+        r3 = abs(res[3])
+        worst3 = max(worst3, r3)
+        worst_w = max(worst_w, abs(rw))
+        cg_fx_dev = max(cg_fx_dev, abs(sg_b["cg"][3]
+                                       - sum(sg_b["fx"])))
+        for i, rv in enumerate(res):
+            if abs(rv) > worst_v:
+                worst_v, worst_i = abs(rv), i
+        if max(abs(x) for x in res) > P3_WINDOW_NS or abs(rw) > P3_WINDOW_NS:
+            viols.append({"tick": t, "resid3_Ns": r3, "resid_world_Ns": abs(rw),
+                          "worst_coord": max(range(len(res)),
+                                             key=lambda i: abs(res[i])),
+                          "worst_Ns": max(abs(x) for x in res)})
+    meds = []
+    for a in rows:
+        t = a["tick"]
+        if WALK_LO <= t < WALK_HI and (t + 1) in by and "igen" in by[t + 1].get("signed", {}):
+            res = _p3_residual(by[t + 1]["signed"], a["signed"])
+            meds.append(abs(res[3]))
+    med3 = statistics.median(meds) if meds else None
+    # continuity report: the v1 direction-free containment on the same rows
+    cont_fail = 0
+    mass = rows[0]["support"]["mass_kg"]
+    for a in rows:
+        t = a["tick"]
+        if not (WALK_LO <= t < WALK_HI) or (t + 1) not in by:
+            continue
+        b = by[t + 1]
+        imp = mass * (b["support"]["east"] - a["support"]["east"])
+        bound = sum(abs(p["friction_force_N"])
+                    for p in b["contact"]["points"]) * DT_S
+        if abs(imp) - bound > P3_WINDOW_NS:
+            cont_fail += 1
+    outcome = ("CLOSURE" if total > 0 and not viols else "RESIDUAL")
+    return {"outcome": outcome, "transitions_evaluated": total,
+            "violation_count": len(viols), "violations": viols[:20],
+            "window_Ns": P3_WINDOW_NS,
+            "window_note": "per-tick absolute; corrected-identity "
+                           "convention; not widened (Lt slot answer)",
+            "forms_decided": "generalized per-coordinate AND world-east "
+                             "(both must hold; the world form is the "
+                             "sign-sensitive one P10 breaks)",
+            "worst_resid_Ns": worst_v, "worst_coord": worst_i,
+            "worst_resid3_Ns": worst3, "median_resid3_Ns": med3,
+            "worst_resid_world_Ns": worst_w,
+            "cg3_vs_fxsum_max_dev_Ns": cg_fx_dev,
+            "v1_containment_failures_same_rows": cont_fail,
+            "units": UNITS["P3_signed_identity"],
+            "pass": outcome == "CLOSURE"}
+
+
+def eval_p4(rows) -> dict:
+    """P4 LEDGER RE-ATTEMPT. (m1) IDENTITY-WITH-ANCHOR: balance(300) equals
+    the sealed raw value -- failure = INSTRUMENT DEFECT (stop), not
+    physics. (m2) LOCALIZATION: per-candidate cumulative tracking of the
+    engine balance residual over the window (convention declared
+    pre-data: max deviation <= 1e-6 J = LOCALIZED_TO)."""
+    bal = {r["tick"]: r["energy"]["balance_error_J"] for r in rows}
+    b300 = bal.get(WALK_HI)
+    m1 = (b300 is not None and abs(b300 - SEALED_BAL300_J) <= 1e-9)
+    incs = [(t, bal[t1] - bal[t]) for t, t1 in
+            zip([x for x in sorted(bal) if WALK_LO <= x < WALK_HI],
+                [x for x in sorted(bal) if WALK_LO < x <= WALK_HI])]
+    worst_inc = max((abs(d) for _, d in incs), default=0.0)
+    rows_map = {r["tick"]: r for r in rows}
+
+    def poscorr_du(sg):
+        return sum(e["du_J"] for e in sg["poscorr"]) if sg["poscorr"] else 0.0
+
+    def cum_track(per_tick_delta):
+        """acc[t] = sum of per-tick deltas over transitions [60..t]; the
+        balance B(t)-B(60) is compared against acc[t] at each tick."""
+        acc, out = 0.0, {WALK_LO: 0.0}
+        for t in range(WALK_LO, WALK_HI):
+            a, b = rows_map[t], rows_map[t + 1]
+            acc += per_tick_delta(a, b)
+            out[t + 1] = acc
+        return out
+
+    def eng_delta(key):
+        return lambda a, b: b["energy"][key] - a["energy"][key]
+
+    B0 = bal[WALK_LO]
+    cands = {
+        # signed-recorder per-tick channels (already per-tick amounts)
+        "cw_contact": cum_track(lambda a, b: b["signed"]["cw_contact_J"]),
+        "cw_stop": cum_track(lambda a, b: b["signed"]["cw_stop_J"]),
+        "poscorr_du_booked": cum_track(lambda a, b: -poscorr_du(b["signed"])),
+        # the engine's own cumulative ledger terms (deltas)
+        "impact_heat_total": cum_track(eng_delta("impact_heat_J")),
+        "friction_heat": cum_track(eng_delta("friction_heat_J")),
+        "damping_heat": cum_track(eng_delta("damping_heat_J")),
+        "actuator_work": cum_track(eng_delta("actuator_work_J")),
+        "external_work": cum_track(eng_delta("external_work_J")),
+        "brake_heat": cum_track(eng_delta("brake_heat_J")),
+    }
+    loc = {}
+    for name, ser in cands.items():
+        worst = max((abs((bal[t] - B0) - ser[t])
+                     for t in ser if t in bal), default=None)
+        loc[name] = {"worst_dev_J": worst,
+                     "localized": worst is not None and worst <= P4_LOC_WINDOW_J}
+    # substep/poscorr localization pointers (emitted, decision support)
+    sub_worst, pc_worst = [], []
+    for t in range(WALK_LO, WALK_HI + 1):
+        r = rows_map.get(t)
+        if r is None or "signed" not in r:
+            continue
+        inc = abs(bal[t] - (bal[t - 1] if t - 1 in bal else bal[t]))
+        for srow in r["signed"]["substeps"]:
+            sub_worst.append((inc, t, max(abs(v) for v in srow.values()
+                                          if isinstance(v, (int, float)))))
+        if r["signed"]["poscorr"]:
+            pc_worst.append({"tick": t, "poscorr": r["signed"]["poscorr"],
+                             "bal_inc_J": inc})
+    localized_to = sorted(n for n, v in loc.items() if v["localized"])
+    return {"m1_identity_with_anchor": {
+                "bal_at_300": b300, "sealed_raw": SEALED_BAL300_J,
+                "exact_within_1e-9": m1,
+                "meaning": "failure = INSTRUMENT DEFECT (stop), not physics"},
+            "m2_localization": {
+                "candidates": loc,
+                "localized_to": localized_to,
+                "not_localized": len(localized_to) == 0,
+                "window_J": P4_LOC_WINDOW_J,
+                "convention": "candidate c LOCALIZED_TO iff max_t |B(t)-B(60)"
+                              " - (C(t)-C(60))| <= 1e-6 J over [60,300]; "
+                              "declared pre-data"},
+            "worst_per_tick_inc_J": worst_inc, "window_J": GE_WINDOW_J,
+            "substep_pointers": sorted(sub_worst, reverse=True)[:5],
+            "poscorr_events_window": pc_worst[:10],
+            "units": UNITS["P4_ledger"],
+            "gate": "closed" if worst_inc <= GE_WINDOW_J else "FIRED",
+            "pass": m1}
+
+
+def eval_p5(rows_mu0, rows_clean) -> dict:
+    """P5 ZERO-FRICTION CONTROL (frozen common-window form): mu0 must not
+    ADVANCE the body faster than the frictional walk per tick; the
+    collapse/coast classification is recorded beside it. Truncated arms
+    report TRUNCATED (early-refusal law)."""
+    mus = {r["contact"]["friction_mu"] for r in rows_mu0}
+    ce = {r["tick"]: r["support"]["east"] for r in rows_clean}
+    me = {r["tick"]: r["support"]["east"] for r in rows_mu0}
+    hi_c, hi_m = max(ce), max(me)
+    lo, hi = WALK_LO, min(hi_c, hi_m)
+    truncated = hi < WALK_HI
+    adv_c = [ce[t + 1] - ce[t] for t in range(lo, hi) if t + 1 in ce]
+    adv_m = [me[t + 1] - me[t] for t in range(lo, hi) if t + 1 in me]
+    mean_c = statistics.mean(adv_c) if adv_c else 0.0
+    mean_m = statistics.mean(adv_m) if adv_m else 0.0
+    ratio = (mean_m / mean_c) if mean_c else None
+    return {"mu_values_seen": sorted(mus),
+            "common_window": [lo, hi], "truncated": truncated,
+            "truncation_note": ("mu0 arm refused at tick %d; common window "
+                                "used; NEVER normalized to a full-window "
+                                "PASS" % hi_m) if truncated else "",
+            "clean_mean_advance_m_per_tick": mean_c,
+            "mu0_mean_advance_m_per_tick": mean_m,
+            "ratio": ratio, "fires_above": P5_RATIO_BOUND,
+            "clean_window_refused_at": hi_c,
+            "units": UNITS["P5"],
+            "pass": mus == {0.0} and ratio is not None and ratio <= P5_RATIO_BOUND}
+
+
+def eval_p6(rows) -> dict:
+    """P6 DRIVE-CUT (frozen gate = the IMPLEMENTED high-water invariant;
+    the per-step rise census is EMITTED, never gated -- the Appendix-2(b)
+    correction). p(t) = momentum during transition t->t+1."""
+    m = rows[0]["support"]["mass_kg"]
+    east = {r["tick"]: r["support"]["east"] for r in rows}
+
+    def mom(t):
+        return m * (east[t + 1] - east[t]) * (1.0 / DT_S)
+
+    if CUT_TICK not in east or CUT_TICK + 1 not in east:
+        return {"pass": False, "measured": False,
+                "note": "run refused before the cut window"}
+    p0 = mom(CUT_TICK)
+    worst = 0.0
+    rises = []
+    for t in range(CUT_TICK, min(CUT_TICK + 100, max(east))):
+        if t not in east or t + 1 not in east:
+            continue
+        p = mom(t)
+        worst = max(worst, p - p0)
+        if t + 2 in east:
+            step_rise = mom(t + 1) - mom(t)
+            if step_rise > P6_MOM_WINDOW:
+                rises.append({"tick": t + 1, "rise_kg_m_s": step_rise})
+    return {"max_rise_above_postcut_kg_m_s": worst,
+            "per_step_rise_census": rises[:24],
+            "per_step_rise_count": len(rises),
+            "window": P6_MOM_WINDOW, "measured": True,
+            "units": UNITS["P6"],
+            "gate_form": "high-water (the implemented invariant); the "
+                         "per-step rises are EMITTED, not gated",
+            "pass": worst <= P6_MOM_WINDOW}
+
+
+def eval_p7(rows_tam, rows_clean) -> dict:
+    """P7 CAP-RAISE TAMPER: the sealed-cap torque flags AND the signed
+    actuator-impulse envelope must both separate tampered from clean."""
+    def flags(rows_):
+        out = []
+        for r in rows_:
+            for j in r["joints"]:
+                if j["name"] == "hip_flexion_left" and \
+                        abs(j["motor_torque_N_m"]) > SEALED_HIP_CAP + 1e-9:
+                    out.append({"tick": r["tick"], "tau": j["motor_torque_N_m"]})
+        return out
+    tam, cln = flags(rows_tam), flags(rows_clean)
+
+    def act_series(rows_):
+        """CORRECTION-1 (2026-10-04, pre-rerun): the first sealed battery
+        (job 4b88e42f) read act_imp[3] -- base_trans_x, STRUCTURALLY ZERO
+        (the engine requires base-coordinate torque == 0) -- so the signed
+        sub-check read 0.0 on both arms and P7 failed on an evaluator
+        defect, not physics. The corrected, coordinate-free form: the
+        per-tick TOTAL generalized actuator impulse magnitude
+        sum_i |act_imp[i]| (N*s); the raised cap must raise the tampered
+        drive's impulse envelope on the flagged ticks, and the
+        deterministic arms differ ONLY there."""
+        out = {}
+        for r in rows_:
+            if "signed" in r and WALK_LO <= r["tick"] <= WALK_HI:
+                out[r["tick"]] = sum(abs(x) for x in r["signed"]["act_imp"])
+        return out
+    st, sc = act_series(rows_tam), act_series(rows_clean)
+    common = sorted(set(st) & set(sc))
+    env_t = max((st[t] for t in common), default=0.0)
+    env_c = max((sc[t] for t in common), default=0.0)
+    return {"tampered_count": len(tam), "clean_count": len(cln),
+            "tampered_exceeding_sealed_cap": tam[:10],
+            "signed_act_total_Ns_tampered": env_t,
+            "signed_act_total_Ns_clean": env_c,
+            "signed_channel_separates": env_t > env_c,
+            "correction": "CORRECTION-1: act_imp[3] (structurally zero) "
+                          "replaced by the coordinate-free total "
+                          "|act_imp| envelope",
+            "units": UNITS["P7"],
+            "pass": len(tam) > 0 and len(cln) == 0 and env_t > env_c}
+
+
+def eval_p9(tel_inj: Path, tel_clean: Path) -> dict:
+    a = telemetry(tel_inj, "w1")
+    b = {r["tick"]: r for r in telemetry(tel_clean, "w1")}
+    first_div = None
+    for r in a:
+        o = b.get(r["tick"])
+        if o is None:
+            continue
+        if json.dumps(r, sort_keys=True) != json.dumps(o, sort_keys=True):
+            first_div = r["tick"]
+            break
+    return {"first_divergence_tick": first_div, "injected_at": INJ_TICK,
+            "caught": first_div is not None,
+            "pass": first_div is not None and first_div == INJ_TICK}
+
+
+def eval_p10(rows_flip, rows_clean, rec_flip) -> dict:
+    """P10 SIGN-FLIP TOOTH: the emitted tangent signs flip; the signed
+    evaluator MUST degrade (t1) and the median residual MUST rise (t2);
+    the mutant arm's anchor set must STILL be exact (telemetry-only
+    mutant). Failure of either assertion = the signed evaluator is
+    VACUOUS."""
+    anchor_side = {
+        "stdout_sha": rec_flip["stdout_sha256"] == SEALED_STDOUT_SHA,
+        "stderr_sha": rec_flip["stderr_sha256"] == SEALED_STDERR_SHA,
+        "qdump1_sha": rec_flip["qdump1_sha256"] == SEALED_QDUMP_SHA,
+        "qdump2_sha": rec_flip["qdump2_sha256"] == SEALED_QDUMP_SHA,
+    }
+    by = {r["tick"]: r for r in rows_flip}
+    byc = {r["tick"]: r for r in rows_clean}
+    res_c, res_f = [], []
+    fails_clean = fails_flip = 0
+    flip_only_failures = []
+    for a in rows_clean:
+        t = a["tick"]
+        if not (WALK_LO <= t < WALK_HI) or (t + 1) not in by or (t + 1) not in byc:
+            continue
+        bf, bc = by[t + 1], byc[t + 1]
+        if "signed" not in bf or "signed" not in bc:
+            continue
+        rc = _p3_world_residual(bc, a)   # the sign-sensitive world form
+        rf = _p3_world_residual(bf, a)
+        res_c.append(abs(rc))
+        res_f.append(abs(rf))
+        fc = abs(rc) > P3_WINDOW_NS
+        ff = abs(rf) > P3_WINDOW_NS
+        fails_clean += fc
+        fails_flip += ff
+        tan_sum = abs(sum(bf["signed"]["fx"]) + sum(bf["signed"]["ifx"]))
+        if ff and not fc and tan_sum > P10_FLOOR_NS:
+            flip_only_failures.append({"tick": t, "resid_world_Ns": abs(rf),
+                                       "tangent_sum_Ns": tan_sum})
+    pass_clean = len(res_c) - fails_clean
+    pass_flip = len(res_f) - fails_flip
+    t1 = pass_flip < pass_clean and len(flip_only_failures) >= 1
+    mc = statistics.median(res_c) if res_c else 0.0
+    mf = statistics.median(res_f) if res_f else 0.0
+    t2 = mf > mc
+    return {"anchor_side_condition": anchor_side,
+            "pass_count_clean": pass_clean, "pass_count_flip": pass_flip,
+            "flip_only_failures": flip_only_failures[:10],
+            "flip_only_failure_count": len(flip_only_failures),
+            "t1_degrades": t1,
+            "median_resid3_clean_Ns": mc, "median_resid3_flip_Ns": mf,
+            "t2_median_rises": t2,
+            "floor_Ns": P10_FLOOR_NS, "units": UNITS["P10"],
+            "vacuous_evaluator": not (t1 and t2),
+            "pass": all(anchor_side.values()) and t1 and t2}
+
+
+# ------------------------------------------------------------------ main
