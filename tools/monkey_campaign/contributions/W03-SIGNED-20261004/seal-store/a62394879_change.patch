+def dimensional_checks() -> dict:
+    """The units law: recorded BEFORE any numeric claim is read."""
+    return {
+        "P3_lhs_kg_m_s": True, "P3_rhs_kg_m_s": True,
+        "P3_coherent": True,
+        "P3_note": "kg*m/s == N*s (s*dN/dt identity); every channel term "
+                   "recorded as an impulse over the tick",
+        "P4_all_terms_J": True, "P4_coherent": True,
+        "P5_m_per_tick": True,
+        "P6_kg_m_s": True,
+        "P7_Nm_and_Ns": True,
+        "P10_Ns": True,
+        "v1_containment_form": "|m*d(COMx)| [kg*m] vs sum|f|*dt [N*s] "
+                               "== kg*m/s -- the SAME unit; the sealed "
+                               "lineage's error was comparing it against "
+                               "a raw force",
