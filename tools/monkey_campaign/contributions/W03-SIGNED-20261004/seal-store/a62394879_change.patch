+}
+inline double positive(double x, const char* code) {
+    finite(x); require(x > 0, code); return x;
+}
+inline double poly(const json& a, double x) {
+    double y = 0;
+    for (auto it = a.rbegin(); it != a.rend(); ++it) y = y*x + number(*it);
+    return finite(y);
