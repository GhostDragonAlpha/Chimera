+    "P1": "hashes/counts (dimensionless); dx/dy m",
+    "P3_signed_identity": "lhs delta_p = (M v)[i](t) - (M v)[i](t-1) in "
+                          "N*s = kg*m/s; rhs channels cg/igen/p_contact/"
+                          "p_stop/gbe/dmp/act_imp/pcorr_dp in N*s; "
+                          "residual N*s",
+    "P4_ledger": "all terms J; localization window J",
+    "P5": "per-tick advance m/tick; ratio dimensionless",
+    "P6": "momentum kg*m/s; window kg*m/s",
+    "P7": "torque N*m; actuator impulse N*s",
+    "P10": "residuals N*s; floor N*s",
+}
