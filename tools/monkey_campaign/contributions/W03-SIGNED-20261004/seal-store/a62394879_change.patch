+              '    end.sa_fx[k]+=w03i_w*(a.rec_fx[k]+2*b.rec_fx[k]+2*c.rec_fx[k]+d.rec_fx[k]);\n'
+              '    end.sa_fy[k]+=w03i_w*(a.rec_fy[k]+2*b.rec_fy[k]+2*c.rec_fy[k]+d.rec_fy[k]);\n'
+              '    end.sa_fz[k]+=w03i_w*(a.rec_fz[k]+2*b.rec_fz[k]+2*c.rec_fz[k]+d.rec_fz[k]);\n'
+              '    end.sa_gen3[k]+=w03i_w*(a.rec_gen3[k]+2*b.rec_gen3[k]+2*c.rec_gen3[k]+d.rec_gen3[k]);}}\n'
+              '  V push{number(config_["push_N"]),0,0};')
+    # H10 the impact friction catch: signed world tangent + normal + e3 row
+    eng.patch("H10_impact_catch",
+              'caught=(std::max)(caught,lambda_n);engaged[k]=1;}}',
