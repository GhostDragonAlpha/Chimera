+#!/usr/bin/env python3
+"""Build the W03I signed instrument from the pinned WALK-PHYS chain.
+
+Chain of record (every step hash-verified by the caller):
+  blob a7bfe15e (gait_unit_viswalk_dump.cpp @ 17ba94b9)
+    --INSTRUMENT_PATCH.py (WALK-PHYS-20261004, sha 35ae38c1 verified)-->
+  gait_unit_viswalk_dump_walkphys.cpp
+    --INSTRUMENT_SIGNED_PATCH.py (THIS SCRIPT)-->
+  gait_controller_signed.hpp + gait_unit_viswalk_dump_w03i.cpp
+
+The engine header input is the pinned blob 5863348f copy (content sha
+f0ffea12...; the walk package's LF copy — EOL handled per file, never
+rewritten wholesale).
+
+LAW (prereg 64298da8..., W03-SIGNED-20261004, section 1): every patch is
+ANCHORED (count==1), ADDITIVE-ONLY, and PURE-RECORDING: added lines read
+existing values into new recording fields; no assignment to any
+pre-existing state; no existing expression reordered or re-evaluated under
+a changed gate. The recorder gate is GaitWalker::srec_on_, set once from
+the GAITPHYS_SIGNED environment; unset => every added line is skipped and
+stdout/stderr/qstream are byte-identical (the P1 anchor law, extended to
+the engine layer). Telemetry goes to FILES only; no new stdout/stderr byte
+exists in any mode.
+
+Signed channels emitted (prereg section 1, S1-S8):
+  S1 per-contact signed world impulse vectors, continuous class:
+     fx/fy/fz per point (east/up/south; RK4-weighted lambda_t*dir,
+     lambda_n) + the per-point e3 (base_trans_x) generalized row gen3.
+  S2 impact class: ifx/ify/ifz + gen3i per point (friction-catch
+     direction from the slip direction; projection normals are world-up).
+  S3 joint stops: p_stop (continuous projection) + stop_imp (impact
+     projection), per generalized coordinate.
+  S4 constraint-work split: sa_cw_contact/sa_cw_stop (the engine's own E8
+     discrete form, per class) beside the untouched total.
+  S5 generalized momentum p = M(q)*v per tick.
+  S6 rhs split: gbe (gravity-bias-external) / dmp (drive damping) per
+     coordinate + act_imp = last_torque_*dt (actuator/servo impulse).
+  S7 substep decomposition: per accepted advance() transition, the ledger
+     term deltas (work/friction-heat/impact-heat/constraint-work/
+     cw-contact/cw-stop/external/damping) + adv_calls census.
+  S8 positional correction: per event {points, dq_max, du} + the
+     configuration jump's own momentum term pcorr_dp (e3^T (M_after -
+     M_before) v; the ONLY channel whose bookkeeping the engine folds
+     into impact heat without a velocity impulse).
+
+Usage:
+  python -B INSTRUMENT_SIGNED_PATCH.py WALKPHYS_CPP HEADER_HPP OUT_DIR
+"""
+import hashlib
+import json
+import sys
+from pathlib import Path
+
+
+def sha_bytes(b: bytes) -> str:
+    return hashlib.sha256(b).hexdigest()
+
+
+class Src:
+    """EOL-agnostic anchored patcher: anchors must occur EXACTLY once, in
+    the file's own EOL convention; hooks are spliced in the same EOL."""
+
+    def __init__(self, path: Path):
+        self.path = path
+        self.raw = path.read_bytes()
+        self.crlf = b"\r\n" in self.raw
+        self.text = self.raw.decode("utf-8")
+        self.names = []
+
+    def _eol(self, s: str) -> str:
+        return s.replace("\r\n", "\n").replace("\n", "\r\n") if self.crlf else s
+
+    def patch(self, name: str, anchor: str, hook: str) -> None:
+        a, h = self._eol(anchor), self._eol(hook)
+        n = self.text.count(a)
+        assert n == 1, f"{name}: anchor count {n} != 1"
+        self.text = self.text.replace(a, h)
+        self.names.append(name)
+
+    def write(self, out: Path) -> str:
+        out.parent.mkdir(parents=True, exist_ok=True)
+        data = self.text.encode("utf-8")
+        out.write_bytes(data)
+        return sha_bytes(data)
+
+
+def main() -> None:
+    walkphys_cpp = Path(sys.argv[1])
+    header_hpp = Path(sys.argv[2])
+    out_dir = Path(sys.argv[3])
+    out_dir.mkdir(parents=True, exist_ok=True)
+
+    # ---------------- engine layer: the signed-recording header
+    eng = Src(header_hpp)
+    # H1 the env reader include (additive)
+    eng.patch("H1_env_include",
+              '#include <cstdio>\n#include <memory>\n',
+              '#include <cstdio>\n#include <cstdlib>\n#include <memory>\n'
+              '// W03I SIGNED RECORDER LAYER (W03-SIGNED-20261004; prereg\n'
+              '// 64298da87f019016ef8aad9ae4ca0bbbc850ec43389a680eefe30a382a260d5d):\n'
+              '// additive, PURE-RECORDING state below; gated by srec_on_ (env\n'
+              '// GAITPHYS_SIGNED). Unset env => no added line executes.\n')
+    # H2 the State recorder fields (carried by copies; rejected trial states
+    # discard their own recorder content, exactly like the engine's own ledger)
+    eng.patch("H2a_state_fields",
+              'Dense contact_generalized;\n  State()=default;\n',
+              'Dense contact_generalized;\n'
+              '  // W03I recorder accumulators (pure data; nothing physics reads them):\n'
+              '  std::vector<double> sa_fx,sa_fy,sa_fz,sa_ifx,sa_ify,sa_ifz,sa_gen3,sa_gen3i,sa_igen;\n'
+              '  Dense sa_gbe,sa_dmp,sa_p_contact,sa_p_stop,sa_stop_imp,sa_pcorr_dp;\n'
+              '  double sa_cw_contact=0,sa_cw_stop=0;std::vector<double> sa_poscorr,sa_sub;\n'
+              '  State()=default;\n')
+    eng.patch("H2b_state_ctor",
+              'contact_generalized(n,0.){}};',
+              'contact_generalized(n,0.),\n'
+              '   sa_fx(pts,0.),sa_fy(pts,0.),sa_fz(pts,0.),sa_ifx(pts,0.),sa_ify(pts,0.),sa_ifz(pts,0.),sa_gen3(pts,0.),sa_gen3i(pts,0.),\n'
+              '   sa_gbe(n,0.),sa_dmp(n,0.),sa_p_contact(n,0.),sa_p_stop(n,0.),sa_stop_imp(n,0.),sa_pcorr_dp(n,0.),sa_igen(pts*n,0.){}};')
+    # H3 the per-stage Rate recorder fields
+    eng.patch("H3_rate_fields",
+              'std::vector<int> mode;std::vector<Dense> point_force;\n'
+              '  Rate(size_t n,size_t pts):q(n,0.),v(n,0.),reaction(n,0.),contact_lambda(pts,0.),'
+              'friction_lambda(pts,0.),friction_heat(pts,0.),slip(pts,0.),mode(pts,0),point_force(pts){}};',
+              'std::vector<int> mode;std::vector<Dense> point_force;\n'
+              '  std::vector<double> rec_fx,rec_fy,rec_fz,rec_gen3;Dense r_gbe,r_dmp,p_contact,p_stop; // W03I\n'
+              '  Rate(size_t n,size_t pts):q(n,0.),v(n,0.),reaction(n,0.),contact_lambda(pts,0.),'
+              'friction_lambda(pts,0.),friction_heat(pts,0.),slip(pts,0.),mode(pts,0),point_force(pts),\n'
+              '   rec_fx(pts,0.),rec_fy(pts,0.),rec_fz(pts,0.),rec_gen3(pts,0.),'
+              'r_gbe(n,0.),r_dmp(n,0.),p_contact(n,0.),p_stop(n,0.){}};')
+    # H4 the gate member + H5 the ctor env read
+    eng.patch("H4_gate_member",
+              'std::vector<double> posture_phi_,posture_theta_;',
+              'std::vector<double> posture_phi_,posture_theta_;\n'
+              ' bool srec_on_=false; // W03I: recorder gate (env GAITPHYS_SIGNED; unset => false)')
+    eng.patch("H5_ctor_env",
+              'GaitWalker(const J& data,double gravity,V shift,double dt=1/300.):shift_(shift),gravity_{0,-gravity,0},dt_(dt){',
+              'GaitWalker(const J& data,double gravity,V shift,double dt=1/300.):shift_(shift),gravity_{0,-gravity,0},dt_(dt){\n'
+              '  {const char* w03i_env=std::getenv("GAITPHYS_SIGNED");srec_on_=(w03i_env&&w03i_env[0]);(void)w03i_env;} // W03I: one pure env read')
+    # H6 the rhs split: gbe recorded after out exists; dmp captured in the drive branch
+    eng.patch("H6a_rhs_decl",
+              'Dense rhs(n_,0.);double heat=0;',
+              'Dense rhs(n_,0.);double heat=0;Dense w03i_dmp(n_,0.); // W03I: drive-damping rhs piece (recorded below)')
+    eng.patch("H6b_dmp_capture",
+              'rhs[i]+=tau[i]-damping_[d]*s.v[i];heat+=damping_[d]*s.v[i]*s.v[i];}',
+              'rhs[i]+=tau[i]-damping_[d]*s.v[i];heat+=damping_[d]*s.v[i]*s.v[i];'
+              'if(srec_on_)w03i_dmp[i]=-damping_[d]*s.v[i];}')
+    eng.patch("H6c_gbe_record",
+              'Rate out(n_,npts_);out.damping=heat;out.q=s.v;out.v=free;',
+              'Rate out(n_,npts_);out.damping=heat;out.q=s.v;out.v=free;\n'
+              '  if(srec_on_){out.r_dmp=w03i_dmp;'
+              'for(size_t i=0;i<n_;++i)out.r_gbe[i]=e.gravity[i]-e.bias[i]+external[i];} '
+              '// W03I: gbe = rhs before tau/dmp (the IDENTICAL FP expression, re-read only)')
+    # H7 the continuous friction solve: signed world components + e3 row
+    eng.patch("H7_friction_record",
+              'out.friction_heat[k]=-lambda_t*inner(row_t,s.v);}}',
+              'out.friction_heat[k]=-lambda_t*inner(row_t,s.v);'
+              'if(srec_on_){out.rec_fx[k]=lambda_t*dir_x;out.rec_fy[k]=lambda_n;'
+              'out.rec_fz[k]=lambda_t*dir_z;out.rec_gen3[k]=force[3];}}} '
+              '// W03I: signed world tangent/normal + e3 generalized row (pure reads)')
+    # H8 the continuous projection split: contact vs joint-stop per class
+    eng.patch("H8_projection_split",
+              'for(size_t r=0;r<rows.size();++r)if(!rows[r].stop_row)out.contact_lambda[rows[r].point]=(std::max)(out.contact_lambda[rows[r].point],multipliers[r]);',
+              'for(size_t r=0;r<rows.size();++r)if(!rows[r].stop_row)out.contact_lambda[rows[r].point]=(std::max)(out.contact_lambda[rows[r].point],multipliers[r]);\n'
+              '   if(srec_on_)for(size_t r=0;r<rows.size();++r){const NamedRow&rr=rows[r];'
+              'Dense&w03i_dst=rr.stop_row?out.p_stop:out.p_contact;'
+              'for(size_t i=0;i<n_;++i)w03i_dst[i]+=multipliers[r]*rr.row[i];}')
+    # H9 the free_step RK4 accumulation (the engine's own weights)
+    eng.patch("H9_freestep_accum",
+              'end.damping+=h*(a.damping+2*b.damping+2*c.damping+d.damping)/6;\n'
+              '  V push{number(config_["push_N"]),0,0};',
+              'end.damping+=h*(a.damping+2*b.damping+2*c.damping+d.damping)/6;\n'
+              '  if(srec_on_){ // W03I: RK4-weighted signed accumulators (identical weights)\n'
+              '   for(size_t i=0;i<n_;++i){\n'
+              '    double w03i_g=h*(a.r_gbe[i]+2*b.r_gbe[i]+2*c.r_gbe[i]+d.r_gbe[i])/6;end.sa_gbe[i]+=w03i_g;\n'
+              '    double w03i_m=h*(a.r_dmp[i]+2*b.r_dmp[i]+2*c.r_dmp[i]+d.r_dmp[i])/6;end.sa_dmp[i]+=w03i_m;\n'
+              '    double w03i_c=h*(a.p_contact[i]+2*b.p_contact[i]+2*c.p_contact[i]+d.p_contact[i])/6;\n'
+              '    end.sa_p_contact[i]+=w03i_c;end.sa_cw_contact+=w03i_c*(start.v[i]+end.v[i])/2;\n'
