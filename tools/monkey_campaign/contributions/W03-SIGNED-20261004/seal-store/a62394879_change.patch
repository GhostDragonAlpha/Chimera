+        r5 = run_arm(scratch, exe, p_mu0, art, "mu0",
+                     {"GAITPHYS_SIGNED": "1"})
+        p5 = eval_p5(telemetry(art / "telemetry_mu0.jsonl", "w1"), rows1)
+        r6 = run_arm(scratch, exe, scene, art, "cut",
+                     {"GAITPHYS_POWER_CUT_TICK": CUT_TICK,
