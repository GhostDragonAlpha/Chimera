+    1e3*T.walk_step/n,1e3*T.walk_status/n,1e3*T.walk_census/n,
+    n/T.walk_step,n/(T.walk_step+T.walk_status+T.walk_census),
+    ns?ns/T.walk_step_ss:0.,ns?ns/(T.walk_step_ss+T.walk_status_ss+T.walk_census_ss):0.);}
+}
+}
