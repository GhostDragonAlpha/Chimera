+namespace tb1 {
+struct Timing {
+  double fG5=0, push426=0, report=0;
+  double walk_startup=0, walk_step=0, walk_status=0, walk_census=0;
+  double walk_step_ss=0, walk_status_ss=0, walk_census_ss=0; // ticks>=20 per run
