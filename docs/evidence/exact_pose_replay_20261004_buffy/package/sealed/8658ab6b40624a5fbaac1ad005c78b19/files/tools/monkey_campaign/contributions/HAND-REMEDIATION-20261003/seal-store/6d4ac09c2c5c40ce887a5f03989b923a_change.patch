+            sv0 = s
+            break
+    area0 = s3.area_from_receipt(sv0["pad_force_N"], sv0["pad_u"])
+    rev_ticks = []
+    for t_i in range(1, s3.N_TICKS + 1):
+        u_t = s3.schedule_u(sv0["pad_u"], t_i)
+        rev_ticks.append((u_t, -s3.tick_force(u_t, area0),
+                          -s3.tick_force(u_t, area0) * s3.DT_S))
+    rev_cls = classify_sequence(rev_ticks, area0)
+    min_f = min(f for (_u, f, _j) in rev_ticks)
+    rev_ok = (rev_cls == "IDENTITY_MISMATCH" and min_f < 0.0)
+    receipt["controls"]["S3_P5_reversal"] = dict(
+        constructed="the schedule evaluated with the force NEGATED",
+        min_signed_force=min_f, cls=rev_cls,
+        expected="IDENTITY_MISMATCH with a negative signed force (the "
+                 "instrumentation shows the reversal, never absorbs it)",
+        ok=bool(rev_ok))
+    emit("S3-P5 REVERSAL CASE: class=%s min_signed_force=%r (must be "
+         "negative)" % (rev_cls, min_f))
+    # ---- predictions ----
+    for pname in ("q_c_PRIMARY", "q_zero_CONTROL"):
+        po = receipt["postures"][pname]
+        # the pinned S3-P1 scores the PAD_CONTACT class only (348 total):
+        # "all 348 PAD_CONTACT survivors classify IDENTITY_CLOSED"; the
+        # absorbed class is S3-P2's (the erratum's explicit-class law).
+        expected_zero = 6 if pname == "q_c_PRIMARY" else 0
+        contact_n = po["survivors"] - expected_zero
+        pred = dict(
+            S3_P1=dict(posture=pname,
+                       ok=(po["classes"]["IDENTITY_CLOSED"] == contact_n
+                           and po["classes"]["IDENTITY_MISMATCH"] == 0),
+                       contact_survivors=contact_n,
+                       classes=po["classes"],
+                       falsifier="any IDENTITY_MISMATCH (per-tick "
+                                 "residual, cumulative mismatch, or "
+                                 "signed reversal) - a RESULT recorded "
+                                 "with its tick index and signed "
+                                 "residual, routed"),
+            S3_P2=dict(posture=pname,
+                       ok=(po["classes"]["ZERO_FORCE_CLASS"]
+                           == (6 if pname == "q_c_PRIMARY" else 0)),
+                       zero_force=po["classes"]["ZERO_FORCE_CLASS"],
+                       falsifier="any nonzero tick force or impulse on a "
+                                 "u = 0 survivor; the 348/6 split not "
+                                 "reproducing the receipt"),
+        )
+        if pname == "q_c_PRIMARY":
+            pred["S3_P3"] = dict(posture=pname, ok=mu_ctrl["mu0"]["cls"]
+                                 == "NON_CLOSING_AT_MU0",
+                                 falsifier="CLOSED_AT_MU0 falsifies the "
+                                           "law-form implementation "
+                                           "(instrument invalid)")
+            pred["S3_P4"] = dict(posture=pname,
+                                 ok=mu_ctrl["mu_placeholder"]["cls"]
+                                 == "CLOSES",
+                                 falsifier="a non-closure at mu = 0.6 "
+                                           "(the positive control failing "
+                                           "= the law form implemented "
+                                           "wrong)")
+            pred["S3_P5"] = dict(posture=pname, ok=bool(rev_ok),
+                                 falsifier="the reversal case recording a "
+                                           "nonnegative force or closing "
+                                           "clean (the instrumentation "
+                                           "absorbs reversals)")
+        receipt["predictions"][pname] = pred
+    p_ok = {pname: {pk: bool(pv["ok"])
+                    for pk, pv in blocks.items()}
+            for pname, blocks in receipt["predictions"].items()}
+    receipt["predictions_ok"] = p_ok
+    all_ok = all(v for d in p_ok.values() for v in d.values())
+    receipt["verdict"] = ("STAGE3_FORCES_IDENTITY_FULL_SET" if all_ok
+                          else "STAGE3_PREDICTION_FALSIFIED_ROUTED")
+    receipt["wall_clock_s"] = time.time() - _t_start
+    emit("=" * 78)
+    emit("PREDICTIONS: %s" % json.dumps(p_ok, sort_keys=True))
+    emit("VERDICT: %s" % receipt["verdict"])
+    return receipt
+
+
+def main():
+    outdir = os.environ.get("CHIMERA_OUTPUT_DIR", "outputs")
+    os.makedirs(outdir, exist_ok=True)
+    try:
+        receipt = pipeline()
+        text = "\n".join(gs._report) + "\n"
+    except iv.GateRefusal as exc:
+        with open(os.path.join(outdir, "stage3_gate_receipt.json"),
+                  "w", encoding="utf-8", newline="\n") as fh:
+            fh.write(json.dumps(dict(
+                schema="chimera.hand_remediation.gate.v1",
+                ok=False, refusal=exc.detail), indent=1) + "\n")
+        print("REFUSAL: %s" % exc.detail, flush=True)
+        raise SystemExit(3)
+    with open(os.path.join(outdir, OUT_NAME_RECEIPT), "w",
+              encoding="utf-8", newline="\n") as fh:
+        fh.write(canonical(receipt) + "\n")
+    with open(os.path.join(outdir, OUT_NAME_REPORT), "w",
+              encoding="utf-8", newline="\n") as fh:
+        fh.write(text)
+    raise SystemExit(0)
+
+
+if __name__ == "__main__":
+    main()
