+                 "(534+292+128, identical at the raised cap) - PR #335, "
+                 "astra 2944ea90; the governing label for every downstream "
+                 "citation of the stage-1/raised-cap P1")
+
+SCHEDULE_NOTE = ("u(t) from the FROZEN schedule table: ticks 1-20 linear "
+                 "0 -> pad_u; ticks 21-40 held at pad_u; absorbed "
+                 "survivors (pad_u = 0) hold u = 0 across all 40 ticks "
