+        S3_P4_mu_placeholder=dict(expected="CLOSES at the declared "
+                                  "placeholder mu_s = 0.6",
+                                  **mu_ctrl["mu_placeholder"]))
+    mu_ok = bool(mu_ctrl["ok"])
+    emit("S3-P3 MU0: %s | S3-P4 MU0.6: %s (P_req = %r N)"
