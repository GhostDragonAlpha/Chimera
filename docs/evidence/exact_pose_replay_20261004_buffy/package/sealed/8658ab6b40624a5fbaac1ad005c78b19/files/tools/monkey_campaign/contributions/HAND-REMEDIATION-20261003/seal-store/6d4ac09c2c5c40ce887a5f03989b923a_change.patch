+        run_class="stage3_contact_forces (the pinned stage-3 prereg "
+                  "6c1aa445)",
+        delta_note=("new stage: the per-tick SIGNED force/impulse "
+                    "instrumentation over the frozen 40-tick schedules; "
+                    "the declared outcome space {IDENTITY_CLOSED, "
+                    "IDENTITY_MISMATCH, ZERO_FORCE_CLASS} closes over the "
+                    "FINAL survivor set (354); the mu=0 / mu=0.6 law-form "
+                    "control pair; the constructed reversal case. "
+                    "Survivor-set input pinned to the raised-cap receipt "
+                    "bytes 4df5f480...; the erratum's governing P1 label "
+                    "carried in governing_labels; constructed analytic "
+                    "class - NO solver integration claimed."),
+        governing_labels={"P1": s3.ERRATUM_LABEL},
+        lane="E:/ChimeraWork/monkey-coordination/hand-remediation/",
+        stage3_prereg_sha256=s3.STAGE3_PREREG_SHA,
+        survivor_set_input=dict(
+            artifact=s3.RAISED_CAP_RECEIPT_NAME,
+            sha256=s3.RAISED_CAP_RECEIPT_SHA,
+            job="e4a5447bcef64b328f33d1f74cfd892d"),
+        frozen_law=dict(n_ticks=s3.N_TICKS, ramp_ticks=s3.RAMP_TICKS,
+                        dt_s=s3.DT_S, k_pa=s3.K_PA, t_m=s3.T_M,
+                        rel_tol=s3.REL_TOL, mu0=s3.MU0,
+                        mu_placeholder=s3.MU_PLACEHOLDER,
+                        w_scene_n=s3.W_SCENE_N, n_contact=s3.N_CONTACT,
+                        schedule_note=s3.SCHEDULE_NOTE),
+        not_claims=("friction PLACEHOLDER (A5); no monkey-bark value "
+                    "exists; NO solver integration claimed (the per-tick "
+                    "identity here is the declared law form on constructed "
+                    "schedules); the 36 N figure stays conditional on "
+                    "model + mu = 0.6; the absorbed band carries no force "
+                    "and supports nothing; TC-8 = 0/8; the same-hands "
+                    "finding stands; no hold or grasp result exists in "
+                    "this class"),
+        input_gate=gate, postures={}, controls={}, predictions={},
+    )
+    for pname in ("q_c_PRIMARY", "q_zero_CONTROL"):
+        survivors = rc["postures"][pname]["survivors"]
+        rows = []
+        classes = {"IDENTITY_CLOSED": 0, "IDENTITY_MISMATCH": 0,
+                   "ZERO_FORCE_CLASS": 0}
+        viol = []
+        for sv in survivors:
+            pad_u = sv["pad_u"]
+            f_rec = sv["pad_force_N"]
+            area = s3.area_from_receipt(f_rec, pad_u)
+            ticks = []
+            for t_i in range(1, s3.N_TICKS + 1):
+                u_t = s3.schedule_u(pad_u, t_i)
+                f_t = s3.tick_force(u_t, area)
+                j_t = f_t * s3.DT_S
+                ticks.append((u_t, f_t, j_t))
+            cls = classify_sequence(ticks, area)
+            classes[cls] += 1
+            if cls == "IDENTITY_MISMATCH":
+                for t_i, (u_t, f_t, j_t) in enumerate(ticks, start=1):
+                    if f_t < 0.0:
+                        viol.append(dict(posture=pname,
+                                         theta_index=sv["theta_index"],
+                                         mirror=sv["mirror"], tick=t_i,
+                                         signed_force=f_t,
+                                         kind="signed_reversal"))
+                        break
+            rows.append(dict(
+                theta_index=sv["theta_index"], mirror=sv["mirror"],
+                pad_body=sv["pad_body"], pad_class=sv["pad_class"],
+                pad_u=sv["pad_u"], cls=cls,
+                force_first_tick=ticks[0][1], force_hold_tick=ticks[-1][1],
+                impulse_hold_tick=ticks[-1][2],
+                code_path="u(t): schedule_u; F(t): tick_force -> "
+                          "pad_force_column; J(t): F*DT; cumulative vs "
+                          "cumulative_closed_form (the independent "
+                          "closed-form identity)"))
+        coverage_ok = (sum(classes.values()) == len(survivors))
+        receipt["postures"][pname] = dict(
+            survivors=len(survivors), classes=classes,
