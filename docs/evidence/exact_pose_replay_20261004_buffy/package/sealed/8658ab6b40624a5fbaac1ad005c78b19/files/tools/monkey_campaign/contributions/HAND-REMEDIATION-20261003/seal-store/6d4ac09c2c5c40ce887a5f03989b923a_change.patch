+# run_stage3_forces.py - HAND-REMEDIATION-20261003 R1 STAGE 3 (released by
+# the Lieutenant on the pinned stage-3 prereg 6c1aa445 / bytes 4dfb62e0...).
+#
+# Run class `stage3_contact_forces`: a constructed, analytic, ticked contact
+# sequence per audited survivor (the FINAL survivor set 354 from the
+# raised-cap receipt 4df5f480..., pinned in-package), with per-tick SIGNED
+# instrumentation. The declared outcome space {IDENTITY_CLOSED,
+# IDENTITY_MISMATCH, ZERO_FORCE_CLASS} closes over 354; the mu=0 control
+# outcome is exactly one of {NON_CLOSING_AT_MU0, CLOSED_AT_MU0}. THE
+# NOT-CLAIMS SECTION OF THE PINNED PREREG GOVERNS EVERY SENTENCE: friction
+# is PLACEHOLDER (A5); no solver integration is claimed; no hold or grasp
+# result exists anywhere in this pipeline.
+import hashlib
+import json
+import os
+import sys
+import time
+
+HERE = os.path.dirname(os.path.abspath(__file__))
+sys.path.insert(0, HERE)
+import instrument_v2 as iv    # noqa: E402  sealed, unmodified
+import grasp_screen as gs     # noqa: E402  sealed, unmodified
+import stage3_forces as s3    # noqa: E402  the stage-3 module (this package)
+
+OUT_NAME_RECEIPT = "stage3_forces_receipt.json"
+OUT_NAME_REPORT = "stage3_forces_report.txt"
+
+
+def emit(line=""):
+    gs._report.append(line)
+    print(line, flush=True)
+
+
+def sha_of(path):
+    with open(path, "rb") as fh:
+        return hashlib.sha256(fh.read()).hexdigest()
+
+
+def canonical(x):
+    return json.dumps(x, indent=1, sort_keys=True)
+
+
+def classify_sequence(ticks, area):
+    """The declared outcome space per survivor. ticks = [(u_t, F_t, J_t)]
+    signed records; the identity compares the loop cumulative impulse to
+    the INDEPENDENT closed form; the sign check requires F_t >= 0 on the
+    declared inward schedule."""
+    if all(u == 0.0 for (u, _f, _j) in ticks):
+        return "ZERO_FORCE_CLASS"
+    cum = 0.0
+    for t_i, (u_t, f_t, j_t) in enumerate(ticks, start=1):
+        if f_t < 0.0:
+            return "IDENTITY_MISMATCH"
+        cum += j_t
+        cf = s3.cumulative_closed_form(
+            ticks[-1][0], area, t_i) if area is not None else 0.0
+        if abs(cum - cf) > s3.REL_TOL * max(1.0, abs(cf)):
+            return "IDENTITY_MISMATCH"
+    # the cumulative-at-full-hold identity vs the tick law's own hold force
+    f_hold = ticks[-1][1]
+    cf_full = s3.cumulative_closed_form(ticks[-1][0], area, s3.N_TICKS)
+    if area is not None and abs(cum - cf_full) > \
+            s3.REL_TOL * max(1.0, abs(cf_full)):
+        return "IDENTITY_MISMATCH"
+    _ = f_hold
+    return "IDENTITY_CLOSED"
+
+
+def pipeline():
+    _t_start = time.time()
+    pins = {
+        "R1_STAGE3_PREREG.md": s3.STAGE3_PREREG_SHA,
+        s3.RAISED_CAP_RECEIPT_NAME: s3.RAISED_CAP_RECEIPT_SHA,
+        "PREREGISTRATION_R1_PAD_LAYER.md": s3.PREREG_R1_SHA,
+        "R1_AMENDMENT_1.md": s3.AMENDMENT_1_SHA,
+        "R1_AMENDMENT_2.md": s3.AMENDMENT_2_SHA,
+        "instrument_v2.py": s3.INSTRUMENT_SHA,
+        "grasp_screen.py": s3.SCREEN_SHA,
+    }
+    for fname, expect in sorted(pins.items()):
+        got = sha_of(os.path.join(HERE, fname))
+        if got != expect:
+            iv.refuse("input_pin_mismatch", "%s %s" % (fname, got))
+    emit("=" * 78)
+    emit("GATE. all %d in-package pins MATCH (stage-3 prereg %s / raised-"
+         "cap receipt %s)." % (len(pins), s3.STAGE3_PREREG_SHA[:16],
+                               s3.RAISED_CAP_RECEIPT_SHA[:16]))
+    gate, _mut, _stl, _bounds = iv.run_input_gate(
+        os.path.join(HERE, "PREREGISTRATION.md"))
+    emit("INHERITED INPUT GATE ok=%s pins=%d." % (gate["ok"],
+                                                  len(gate["pins"])))
+    with open(os.path.join(HERE, s3.RAISED_CAP_RECEIPT_NAME),
