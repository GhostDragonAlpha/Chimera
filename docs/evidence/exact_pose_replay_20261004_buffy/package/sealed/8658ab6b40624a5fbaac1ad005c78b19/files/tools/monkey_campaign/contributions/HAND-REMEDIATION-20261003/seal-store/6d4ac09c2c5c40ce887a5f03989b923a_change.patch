+
+def schedule_u(pad_u, tick):
+    """The frozen schedule (code path for every u(t) citation)."""
+    if tick <= RAMP_TICKS:
+        return pad_u * tick / float(RAMP_TICKS)
+    return pad_u
+
+
+def area_from_receipt(pad_force_n, pad_u):
+    """The survivor's mask area, recovered as the exact inverse of the
+    frozen force column: A = pad_force_N * t / (K * pad_u) (code path
+    named; consistent with pad_force_column by construction)."""
+    if pad_u <= 0.0:
+        return None
+    return pad_force_n * T_M / (K_PA * pad_u)
+
+
+def tick_force(u, area):
+    """The per-tick SIGNED force magnitude along the declared inward
+    radial (code path: the frozen tick law p = k*(u/t), F = p*A)."""
+    return vp.pad_force_column(u, area) if area is not None else 0.0
+
+
+def cumulative_closed_form(pad_u, area, n):
+    """The INDEPENDENT closed-form cumulative impulse through tick n (the
+    arithmetic identity: a linear ramp's impulse sum has a closed form;
+    two different arithmetic paths to the same quantity = the non-trivial
+    identity tooth)."""
+    if area is None or n <= 0:
+        return 0.0
+    f_hold = K_PA * (pad_u / T_M) * area
+    j_per_ramp_tick = f_hold * DT_S / float(RAMP_TICKS)
+    ramp = min(n, RAMP_TICKS)
+    total = j_per_ramp_tick * ramp * (ramp + 1) / 2.0
+    if n > RAMP_TICKS:
+        total += (n - RAMP_TICKS) * f_hold * DT_S
+    return total
+
+
+# ---------------------------------------------------------------------------
+# the mu law forms (A6; the mu=0 class is a law-form consequence)
+# ---------------------------------------------------------------------------
+def static_closure(w_n, n_contact, mu):
+    """P_req = W/(n*mu): at mu <= 0 the closure diverges -> NON_CLOSING
+    (the G04 FB2 / G06 mu=0 class as a law-form identity)."""
+    if mu <= 0.0:
+        return dict(cls="NON_CLOSING_AT_MU0", p_req_n=None)
+    p = w_n / (n_contact * mu)
+    return dict(cls="CLOSES", p_req_n=p)
+
+
+def mu0_control(w_n=W_SCENE_N, n_contact=N_CONTACT):
+    r0 = static_closure(w_n, n_contact, MU0)
+    r6 = static_closure(w_n, n_contact, MU_PLACEHOLDER)
+    ok = (r0["cls"] == "NON_CLOSING_AT_MU0"
+          and r6["cls"] == "CLOSES"
+          and r6["p_req_n"] is not None and r6["p_req_n"] > 0.0)
+    return dict(mu0=r0, mu_placeholder=r6, ok=bool(ok),
+                labels="friction PLACEHOLDER (A5); no monkey-bark value "
+                       "exists; the 36 N figure stays conditional on "
+                       "model + mu = 0.6")
