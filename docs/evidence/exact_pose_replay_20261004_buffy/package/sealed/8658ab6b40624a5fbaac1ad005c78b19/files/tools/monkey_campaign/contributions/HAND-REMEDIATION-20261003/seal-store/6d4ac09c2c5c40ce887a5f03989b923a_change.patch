+AMENDMENT_2_SHA = ("e96e09a1a925b12d68763139958eaae5897e27c027ecd3670336f5"
+                   "df5bc597cf")
+INSTRUMENT_SHA = vp.INSTRUMENT_SHA
+SCREEN_SHA = vp.SCREEN_SHA
+
+# ---------------------------------------------------------------------------
+# the frozen tick law (prereg section 1-2; NEVER tuned post-run)
+# ---------------------------------------------------------------------------
+N_TICKS = 40
+RAMP_TICKS = 20                # ticks 1-20: u linear 0 -> pad_u; 21-40: hold
+DT_S = 5.0e-3                  # the sealed scene tick (jn/60 = 0.3/60)
+K_PA = vp.K                    # 4650.718448799368 Pa (amendment-1)
+T_M = vp.T                     # 2.0e-3 m
+REL_TOL = 1e-12                # the declared identity tolerance
+MU0 = 0.0                      # the non-closing control
+MU_PLACEHOLDER = 0.6           # the DECLARED placeholder (A5)
