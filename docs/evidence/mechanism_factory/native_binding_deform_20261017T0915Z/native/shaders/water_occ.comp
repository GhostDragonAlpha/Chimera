// water_occ.comp — macro-step post-pass: hard-exclude occupied cells
// (the cube veto): V[occ] = 0. Matches the reference's line-351 semantics.
#version 460
layout(local_size_x = 256) in;

layout(push_constant) uniform PC {
    uint n;
    uint pad0;
} pc;

layout(std430, binding = 0) buffer VBuf { int V[]; };
layout(std430, binding = 1) readonly buffer Occ { uint occ[]; };

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    if (occ[i] != 0u) V[i] = 0;
}
