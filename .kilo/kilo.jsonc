{
  "$schema": "https://app.kilo.ai/config.json",
  "snapshot": false,
  "mcp": {
    "unreal-engine": {
      "type": "local",
      "command": ["npx", "unreal-engine-mcp-server"],
      "cwd": "E:/PythonChimera/Chimera",
      "environment": {
        "UE_PROJECT_PATH": "E:/PythonChimera/Chimera",
        "MCP_AUTOMATION_PORT": "8091"
