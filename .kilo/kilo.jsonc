      "type": "local",
      "command": ["npx", "@playwright/mcp@latest"]
    },
    "graphify": {
      "type": "local",
      "command": ["C:\\Users\\allen\\AppData\\Roaming\\Python\\Python314\\Scripts\\graphify-mcp.exe", "E:/PythonChimera/Chimera/docs/chimera_knowledge_graph.json"],
      "cwd": "E:/PythonChimera/Chimera"
    }
  }
}
