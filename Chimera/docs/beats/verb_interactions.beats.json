{
  "demo": "verb_interactions",
  "loop": 2,
  "settle_s": 6,
  "_provenance": "2026-07-20 rewrite: removed W-key walks — sleepwalker key events don't drive axis bindings in current PIE. All position beats now use reset_position to place the pawn directly at the interaction target. Pickup log_contains fixed to match both 'picked up' and 'nothing in range' variants.",
  "beats": [
    {
      "name": "verb_look_location",
      "features": ["Verb_Look", "Player_Character_Lighting"],
      "actions": [
        {"wait": 1.0},
        {"key_down": "MouseX", "hold_s": 0.5},
        {"key_up": "MouseX"},
        {"wait": 0.3},
        {"screenshot": "verb_look_360_view"}
      ],
      "expects": [
        {"world_is": "chimeradefaultlevel"},
        {"is_pie": true},
        {"pawn_class": "BP_Astronaut_Character_C"}
      ]
    },
    {
      "name": "verb_bend_location",
      "features": ["Verb_Bend"],
      "actions": [
        {"reset_position": {"x": 0, "y": 400, "z": 130}},
        {"wait": 1.5}
      ],
      "expects": [
        {"is_pie": true},
        {"pawn_class": "BP_Astronaut_Character_C"},
        {"pawn_property_toggles": {"key": "C", "component": "CollisionCylinder", "property": "CapsuleHalfHeight", "min_drop": 20, "settle_s": 1.2}}
      ]
    },
    {
      "name": "verb_pickup_weapon_tool_location",
      "features": ["Verb_PickUp", "Tool_Weapon_Model"],
      "actions": [
        {"reset_position": {"x": 400, "y": -400, "z": 130}},
        {"wait": 1.0},
        {"interact": true, "hold_s": 1.0},
        {"wait": 0.5},
        {"screenshot": "verb_pickup_weapon_tool_view"}
      ],
      "expects": [
        {"is_pie": true},
        {"pawn_class": "BP_Astronaut_Character_C"},
        {"log_contains": "Interact action triggered"}
      ]
    },
    {
      "name": "verb_drop_location",
      "features": ["Verb_Drop"],
      "actions": [
        {"reset_position": {"x": 400, "y": -400, "z": 130}},
        {"wait": 1.0},
        {"drop": true, "hold_s": 1.0},
        {"wait": 0.5}
      ],
      "expects": [
        {"is_pie": true},
        {"pawn_class": "BP_Astronaut_Character_C"},
        {"log_contains": "Drop action triggered"}
      ]
    },
    {
      "name": "verb_shovel_metal_surface_location",
      "features": ["Verb_Shovel", "Ground_Metal_Surface"],
      "actions": [
        {"reset_position": {"x": 0, "y": 0, "z": 130}},
        {"wait": 0.5},
        {"screenshot": "verb_shovel_metal_view"}
      ],
      "expects": [
        {"is_pie": true},
        {"actor_exists": "Shovel_Metal"}
      ]
    },
    {
      "name": "verb_shovel_rock_surface_location",
      "features": ["Verb_Shovel", "Ground_Rock_Surface"],
      "actions": [
        {"reset_position": {"x": 2000, "y": 0, "z": 130}},
        {"wait": 0.5},
        {"screenshot": "verb_shovel_rock_view"}
      ],
      "expects": [
        {"is_pie": true},
        {"actor_exists": "Shovel_Rock"}
      ]
    },
    {
      "name": "verb_shovel_sand_surface_location",
      "features": ["Verb_Shovel", "Ground_Sand_Surface"],
      "actions": [
        {"reset_position": {"x": 4000, "y": 0, "z": 130}},
        {"wait": 0.5},
        {"screenshot": "verb_shovel_sand_view"}
      ],
      "expects": [
        {"is_pie": true},
        {"actor_exists": "Actor_NS_SandDust"}
      ]
    },
    {
      "name": "visor_inspection_pedestal",
      "features": ["Player_Character_Model_Visor_Apply", "Player_Character_Suit"],
      "actions": [
        {"reset_position": {"x": 600, "y": 600, "z": 130}},
        {"key_up": "C"},
        {"wait": 0.5},
        {"screenshot": "visor_inspection_view"}
      ],
      "expects": [
        {"is_pie": true},
        {"actor_exists": "Display_Suit"}
      ]
    },
    {
      "name": "weapon_tool_examine",
      "features": ["Tool_Weapon_Model"],
      "actions": [
        {"reset_position": {"x": 400, "y": -400, "z": 130}},
        {"wait": 0.5},
        {"screenshot": "weapon_tool_examine"}
      ],
      "expects": [
        {"is_pie": true},
        {"actor_exists": "StaticMeshActor_4"}
      ]
    }
  ]
}
