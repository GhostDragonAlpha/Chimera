{
  "demo": "chimera_complete",
  "loop": 0, "settle_s": 4,
  "_provenance": "Complete game verification: world, verbs, NPCs, education, sacrifice, generation.",
  "beats": [
    {
      "name": "world_exists",
      "features": ["Verb_Look", "Player_Character_Lighting", "Ground_Sand_Surface"],
      "actions": [{"wait": 1.5}, {"screenshot": "world_overview"}],
      "expects": [{"is_pie": true}, {"pawn_class": "BP_Astronaut_Character_C"}, {"world_is": "chimeradefaultlevel"}]
    },
    {
      "name": "verbs_work",
      "features": ["Verb_Bend", "Verb_Drop"],
      "actions": [{"reset_position": {"x": 0, "y": 400, "z": 130}}, {"wait": 1.0}],
      "expects": [{"is_pie": true}, {"pawn_property_toggles": {"key": "C", "component": "CollisionCylinder", "property": "CapsuleHalfHeight", "min_drop": 20, "settle_s": 1.0}}]
    },
    {
      "name": "npcs_present",
      "features": ["NPC_Basic_Model", "Social_Conflict"],
      "actions": [{"reset_position": {"x": 0, "y": 0, "z": 2000}}, {"wait": 1.5}],
      "expects": [{"is_pie": true}, {"actor_exists": "NPC_Trader"}, {"actor_exists": "NPC_Pirate"}, {"actor_exists": "NPC_Merchant"}, {"actor_exists": "NPC_Guardian"}]
    },
    {
      "name": "collect_geology",
      "features": ["Verb_PickUp", "Ground_Geology_Surface", "Ground_Geology_Education"],
      "actions": [{"reset_position": {"x": 500, "y": 0, "z": 130}}, {"wait": 0.5}, {"interact": true, "hold_s": 1.0}, {"wait": 0.3}, {"screenshot": "collect_geology"}],
      "expects": [{"is_pie": true}, {"log_contains": "Interact action triggered"}, {"actor_exists": "EduLabel_Basalt"}]
    },
    {
      "name": "collect_celestial",
      "features": ["Verb_PickUp", "Ground_Celestial_Data"],
      "actions": [{"reset_position": {"x": 1000, "y": 900, "z": 130}}, {"wait": 0.5}, {"interact": true, "hold_s": 1.0}, {"wait": 0.3}, {"screenshot": "collect_celestial"}],
      "expects": [{"is_pie": true}, {"actor_exists": "EduLabel_Star"}]
    },
    {
      "name": "sacrifice_at_erisaid",
      "features": ["Verb_Drop", "System_Sacrifice"],
      "actions": [{"reset_position": {"x": 50, "y": 0, "z": 130}}, {"wait": 0.5}, {"drop": true, "hold_s": 1.0}, {"wait": 1.0}],
      "expects": [{"is_pie": true}, {"log_contains": "Drop action triggered"}]
    },
    {
      "name": "generation_transition",
      "features": ["System_Generation", "Universe_Star_Memorial"],
      "actions": [{"reset_position": {"x": 50, "y": 0, "z": 130}}, {"wait": 0.5}, {"key": "K", "hold_s": 0.3}, {"wait": 1.0}, {"screenshot": "generation_complete"}],
      "expects": [{"is_pie": true}, {"log_contains": "Generation"}]
    }
  ]
}
