{
  "demo": "social_trade",
  "loop": 5,
  "settle_s": 6,
  "_provenance": "Social_Trade beat script for NPC trade interactions. Exercises UNPCTradeComponent functionality: player proximity to NPC with trade component, StartTradeInteraction/EndTradeInteraction calls.",
  "beats": [
    {
      "name": "social_trade_npc_proximity",
      "features": ["Social_Trade"],
      "actions": [
        {"reset_position": {"x": 0, "y": 400, "z": 130}},
        {"wait": 1.5}
      ],
      "expects": [
        {"is_pie": true},
        {"pawn_class": "BP_Astronaut_Character_C"},
        {
          "log_contains": "[NPCTrade] Player within trade range",
          "note": "Social_Trade witness: NPC trade component must report player in range"
        }
      ]
    },
    {
      "name": "social_trade_npc_interact",
      "features": ["Social_Trade"],
      "actions": [
        {"reset_position": {"x": 0, "y": 400, "z": 130}},
        {"wait": 1.5},
        {"interact": true, "hold_s": 1.0},
        {"wait": 0.5}
      ],
      "expects": [
        {"is_pie": true},
        {"pawn_class": "BP_Astronaut_Character_C"},
        {
          "log_contains": "[NPCTrade] Trade interaction started",
          "note": "Social_Trade witness: NPC trade component must report trade interaction start"
        }
      ]
    }
  ]
}
