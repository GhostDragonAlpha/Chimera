{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "workflow_id": {
      "type": "string",
      "description": "Unique identifier for the workflow"
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "step_id": {"type": "string"},
          "operation": {
            "type": "string",
            "enum": ["semantic_match", "log_alignment", "conditional_branch"]
          },
          "source_uid": {
            "type": "string",
            "pattern": "^TERM_\\d+$"
          },
          "target_uid": {
            "type": "string",
            "pattern": "^TERM_\\d+$",
            "nullable": true
          },
          "condition": {"type": "string", "nullable": true},
          "confidence_score": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0,
            "nullable": true
          }
        },
        "required": ["step_id", "operation", "source_uid"],
        "additionalProperties": false
      }
    }
  },
  "required": ["workflow_id", "steps"],
  "additionalProperties": false
}
