game "CelestialsTestGame" {
    engine_version = "5.8";
    target_platforms = ["PC", "PS5", "XboxSeries"];
}

technical {
    network_model = "client_server";
    performance { target_fps=60, LOD_strategy="standard" };
    module_dependencies = ["PCG", "Niagara", "LevelSequence", "NetCore"];
}

celestial_systems {
    celestial_body "Aurelia_Prime" {
        type = "gas_giant";
        radius_km = 71492;
        atmosphere_density = 0.85;
        has_moons = true;
        moon_count = 3;
        atmospheric_composition = ["nitrogen", "methane", "hydrogen"];
    }

    celestial_body "Terra_New" {
        type = "terrestrial";
        radius_km = 6371;
        atmosphere_density = 0.92;
        has_moons = false;
        moon_count = 0;
        atmospheric_composition = ["nitrogen", "oxygen", "argon"];
        surface_temperature_min = -50;
        surface_temperature_max = 45;
    }

    celestial_body "Vulcan_Station" {
        type = "space_station";
        radius_km = 12;
        atmosphere_density = 0.60;
        has_moons = false;
        moon_count = 0;
        is_artificial = true;
        station_class = "orbital_refinery";
    }
}
