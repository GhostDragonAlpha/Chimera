game "TDDTestSuiteGame" {
    engine_version = "5.8";
    target_platforms = ["PC"];
}

technical {
    network_model = "client_server";
    performance { target_fps=60, LOD_strategy="standard" };
    module_dependencies = ["GameplayAbilities", "EnhancedInput"];
}

gameplay {
    character "PlayerCharacter" inherits "ACharacter" {
        ability_system_component "ASC_Player";
        attribute_set "AS_PlayerAttributes";
        default_abilities = ["GA_Dash", "GA_ShieldRecharge"];
    }

    ability "Dash" uses GAS {
        ability_tags = [Ability.Dash, Ability.Movement];
        cooldown 3.0 via GE_Dash_Cooldown;
        activation {
            launch_character (properties);
        }
    }

    combat_system {
        damage_formulas = "standard_gas_formula";
        hit_reactions = true;
        status_effects = ["stun", "burn", "shield_depletion"];
    }

    survival_stats {
        hunger_stat = false,
        thirst_stat = false,
        temperature_stat = false;
    }

    crafting_systems {
        recipe "WoodenAxe" {
            inputs = ["Wood", "Stone"],
            output = "WoodenAxe",
            quantity = 1,
        }
        workstation "Workbench_Crafting" {
            type = "general_crafting",
            crafting_radius = 300.0,
        }
    }
}

planet_generation_systems {
    biome_config "frozen_mountain" {
        vegetation_density = 0.05,
        tree_height_range_meters = [5, 15],
        ground_texture_types = ["snow", "ice", "rock_bare"],
        wildlife_spawns = ["arctic_fox"],
        resource_nodes = ["ice_crystals", "frozen_herbs"];
    }
}

economy_systems {
    trade_route "Area18_Market" {
        origin_system = "area_18",
        destination_systems = ["neon_cities", "trading_posts"],
        typical_cargo_types = ["minerals_iron", "food_synthetic"],
        route_safety_rating = 0.85,
        pirate_activity_level = "low";
    }
}

ship_classes {
    ship_class "AnvilCarrack" {
        category = "exploration_vessel",
        crew_capacity = 4,
        cargo_volume_cubic_meters = 2500,
        has_quantum_drive = true,
        has_weapon_systems = true,
        weapon_slots = 4,
        max_speed_km_per_sec = 120,
        shield_class = "medium";
    }
}

tests {
    test "DashCooldownCorrect" {
        type = "unit";
        description = "Dash ability applies exactly 3 second cooldown on activation";
        
        setup {
            spawn_actor(type = "Character", id = "player", class = "PlayerCharacter");
            grant_ability(actor = "player", ability = "Dash");
        }
        
        action {
            activate_ability(actor = "player", ability = "Dash");
        }
        
        assert {
            ability_on_cooldown(actor = "player", ability = "Dash") == true;
            cooldown_remaining(actor = "player", ability = "Dash") == 3.0_sec;
        }
        
        cleanup {
            destroy_actor("player");
        }
    }
    
    test "CraftingConsumesCorrectMaterials" {
        type = "unit";
        description = "Crafting a wooden axe consumes wood and stone correctly";
        
        setup {
            spawn_actor(type = "Character", id = "player", class = "PlayerCharacter");
            add_item(actor = "player", item = "Wood", quantity = 10);
            add_item(actor = "player", item = "Stone", quantity = 5);
        }
        
        action {
            craft_recipe(actor = "player", recipe = "WoodenAxe");
        }
        
        assert {
            inventory_count(actor = "player", item = "Wood") == 9;
            inventory_count(actor = "player", item = "Stone") == 4;
            inventory_contains(actor = "player", item = "WoodenAxe") == true;
        }
    }
    
    test "ShipOverheatPreventsQuantum" {
        type = "integration";
        description = "Destroyed cooler component prevents quantum travel ability activation";
        
        setup {
            spawn_actor(type = "Ship", id = "test_ship", class = "AnvilCarrack");
            set_component_health(actor = "test_ship", component = "cooler", health = 0);
        }
        
        action {
            activate_ability(actor = "test_ship", ability = "QuantumSpool");
        }
        
        assert {
            ability_activated == false;
        }
    }
    
    test "MarketPriceEquilibrium" {
        type = "balance";
        description = "Market reaches price stability within refresh cycles";
        iterations = 10;
        
        setup {
            initialize_market(market = "Area18_Market");
        }
        
        action {
            advance_market_cycles(market = "Area18_Market", cycles = 10);
        }
        
        assert {
            price_volatility(market = "Area18_Market", commodity = "Titanium") <= 0.05;
        }
    }
    
    test "HypothermiaInFreezingWater" {
        type = "integration";
        description = "Wet player in freezing biome takes hypothermia damage over time";
        
        setup {
            spawn_actor(type = "Character", id = "player", class = "PlayerCharacter");
            set_attribute(actor = "player", attribute = "body_temperature", value = 37.0);
            set_status(actor = "player", status = "wet", active = true);
            set_biome(actor = "player", biome = "frozen_mountain");
        }
        
        action {
            wait(30_sec);
        }
        
        assert {
            attribute_value(actor = "player", attribute = "body_temperature") < 37.0;
            status_active(actor = "player", status = "hypothermia") == true;
        }
    }
}
