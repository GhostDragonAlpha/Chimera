game "StarCitizenScaleGame" {
    engine_version = "5.8";
    target_platforms = ["PC", "PS5", "XboxSeries"];
}

game_settings {
    camera_perspective = "third_person";
    game_mode = "multiplayer";
}

narrative {
    act "Act1_StartingOut" {
        start_dialogue "Tutorial_Intro";
    }
    
    dialogue_tree "DT_Tutorial_Intro" {
        node "Node_Start" {
            speaker = "Captain";
            text = "Welcome to the verse. Let us get you started.";
            next = "Node_Next";
        }
        player_choice ["Proceed", "AskMore"] branches {
            Proceed -> node Node_Next {
                speaker = "Captain";
                text = "Good choice. Let us proceed.";
            }
            AskMore -> node Node_MoreInfo {
                speaker = "Captain";
                text = "Here is some additional information.";
            }
        }
    }
}

gameplay {
    character "StarCitizenPlayer" inherits "ACharacter" {
        ability_system_component "ASC_Player";
        attribute_set "AS_PlayerAttributes";
        default_abilities = ["GA_Dash", "GA_ShieldRecharge"];
    }

    ability "Dash" uses GAS {
        ability_tags = [Ability.Dash, Ability.Movement];
        cooldown 3.0 via GE_Dash_Cooldown;
        activation {
            launch_character (properties);
        }
    }

    combat_system {
        damage_formulas = "standard_gas_formula";
        hit_reactions = true;
        status_effects = ["stun", "burn", "shield_depletion"];
    }

    survival_stats {
        hunger_stat = false,
        thirst_stat = false,
        temperature_stat = false;
    }

    crafting_systems {
        recipe "Weapon_Rack" {
            inputs = ["steel_ingot", "circuit_board"],
            output = "weapon_rack",
            quantity = 1,
        }
        workstation "Workbench_Crafting" {
            type = "general_crafting",
            crafting_radius = 300.0,
        }
    }
}

world {
    level "Aegis_Spaceport" {
        environment (using WorldPartition);
        spawn_point "Spawn_Main" at (0, 0, 100);
    }

    npc "Station_Captain" {
        mesh = "SK_StationCaptain",
        behavior_tree = "BT_StationNPC",
        dialogue_tree = "DT_Tutorial_Intro",
        health = 500;
    }
}

ui {
    hud {
        widget "WBP_HUD_Main" {
            health_bar,
            minimap,
            ability_cooldowns,
            quest_tracker,
        };
    }
    pause_menu {
        options_resume,
        options_settings,
        quit_to_main;
    }
}

audio {
    music_cue "Music_Exploration" {
        loop = true,
        volume = 0.8,
    }
    
    sfx "SFX_Quantum_Jump" {
        pitch_variation = 1.2,
    }
    
    dynamic_mixing_rules {
        priority_system = true,
        duck_music_on_damage = true;
    }
}

technical {
    network_model = "client_server";
    replication {
        properties: [Health, ShieldStrength, Position, Rotation];
        rpcs: [Server_MoveToDestination, Server_InteractWithObject];
    }
    performance { target_fps=60, LOD_strategy="standard", culling_distance_multiplier=1.5; }
    module_dependencies = ["GameplayAbilities", "GameplayTags", "GameplayTasks", "EnhancedInput", "PCG", "PCGGeometryScriptInterop", "Niagara", "LevelSequence", "UMG", "CommonUI", "NetCore", "AIModule"];
}

art_direction {
    style = "realistic_scifi";
    color_palette = "industrial_space";
}

celestial_systems {
    celestial_body "Aurelia_Prime" {
        type = "gas_giant",
        radius_km = 71492,
        atmosphere_density = 0.85,
        has_moons = true,
        moon_count = 3,
        atmospheric_composition = ["nitrogen", "methane", "hydrogen"];
    }

    celestial_body "Terra_New" {
        type = "terrestrial",
        radius_km = 6371,
        atmosphere_density = 0.92,
        has_moons = false,
        moon_count = 0,
        atmospheric_composition = ["nitrogen", "oxygen", "argon"],
        surface_temperature_min = -50,
        surface_temperature_max = 45;
    }

    celestial_body "Vulcan_Station" {
        type = "space_station",
        radius_km = 12,
        atmosphere_density = 0.60,
        has_moons = false,
        moon_count = 0,
        is_artificial = true,
        station_class = "orbital_refinery";
    }
}

flight_components {
    component "thruster_module_class_A" {
        type = "chemical_thruster",
        thrust_force_newtons = 50000,
        fuel_consumption_kg_per_sec = 12.5,
        fuel_type = "hydrazine",
        max_temperature_kelvin = 3500;
    }

    component "quantum_drive_core" {
        type = "quantum_travel_drive",
        energy_requirement_megajoules = 10000,
        cool_down_seconds = 45,
        requires_quantum_anchor = true,
        max_range_light_years = 100;
    }

    component "shield_generator_marine" {
        type = "energy_shield",
        shield_strength_points = 5000,
        regeneration_rate_per_sec = 50,
        energy_drain_per_hit = 200,
        shield_type = "kinetic_energy_absorbing";
    }

    component "sensor_array_tactical" {
        type = "long_range_scanner",
        detection_range_km = 50000,
        scan_modes = ["passive", "active_radar", "emission_signatures"],
        jamming_resistance_level = 3;
    }
}

ship_classes {
    ship_class "MoleHauler" {
        category = "freighter",
        crew_capacity = 2,
        cargo_volume_cubic_meters = 5000,
        has_quantum_drive = true,
        has_weapon_systems = false,
        max_speed_km_per_sec = 150,
        shield_class = "light";
    }

    ship_class "Carrack" {
        category = "exploration_vessel",
        crew_capacity = 4,
        cargo_volume_cubic_meters = 2500,
        has_quantum_drive = true,
        has_weapon_systems = true,
        weapon_slots = 4,
        max_speed_km_per_sec = 120,
        shield_class = "medium";
    }

    ship_class "AresMauler" {
        category = "fighter",
        crew_capacity = 1,
        cargo_volume_cubic_meters = 100,
        has_quantum_drive = false,
        has_weapon_systems = true,
        weapon_slots = 6,
        max_speed_km_per_sec = 350,
        shield_class = "light",
        maneuverability_rating = 8;
    }

    ship_class "GladiusFighter" {
        category = "fighter",
        crew_capacity = 1,
        cargo_volume_cubic_meters = 50,
        has_quantum_drive = false,
        has_weapon_systems = true,
        weapon_slots = 4,
        max_speed_km_per_sec = 400,
        shield_class = "light",
        maneuverability_rating = 9;
    }

    ship_class "CutlassRed" {
        category = "multirole_fighter",
        crew_capacity = 3,
        cargo_volume_cubic_meters = 800,
        has_quantum_drive = true,
        has_weapon_systems = true,
        weapon_slots = 2,
        max_speed_km_per_sec = 180,
        shield_class = "medium";
    }
}

economy_systems {
    commodity "minerals_iron" {
        category = "raw_materials",
        base_value_credits = 150,
        market_volatility = 0.05,
        production_locations = ["asteroid_belts", "terrestrial_minings"],
        consumption_regions = ["ship_yards", "construction_zones"];
    }

    commodity "minerals_gold" {
        category = "raw_materials",
        base_value_credits = 8500,
        market_volatility = 0.12,
        production_locations = ["asteroid_belts"],
        consumption_regions = ["luxury_goods", "electronics"];
    }

    commodity "food_synthetic" {
        category = "consumables",
        base_value_credits = 45,
        market_volatility = 0.02,
        production_locations = ["orbital_farms", "terrestrial_agriculture"],
        consumption_regions = ["all_populated_systems"];
    }

    commodity "weapons_military" {
        category = "military_goods",
        base_value_credits = 15000,
        market_volatility = 0.15,
        production_locations = ["defense_contractors"],
        consumption_regions = ["military_outposts", "pirate_havens"],
        trade_restrictions = ["licensed_only"];
    }

    trade_route "core_to_outer_rim" {
        origin_system = "aegis",
        destination_systems = ["crocus", "phobos", "elysium"],
        typical_cargo_types = ["minerals_iron", "food_synthetic"],
        route_safety_rating = 0.75,
        pirate_activity_level = "moderate";
    }
}

quantum_travel_systems {
    quantum_anchor "aegis_station_prime" {
        location_coordinates = [45.2, -12.8, 103.5],
        anchor_strength = 100,
        max_concurrent_jumps = 50,
        recharge_rate_per_second = 2,
        supports_ship_classes = ["MoleHauler", "Carrack", "CutlassRed"];
    }

    quantum_anchor "crocus_outpost" {
        location_coordinates = [78.1, 34.5, -67.2],
        anchor_strength = 75,
        max_concurrent_jumps = 20,
        recharge_rate_per_second = 1.5,
        supports_ship_classes = ["Carrack", "CutlassRed"];
    }

    quantum_jump_path "aegis_to_crocus" {
        origin_anchor = "aegis_station_prime",
        destination_anchor = "crocus_outpost",
        distance_light_years = 12.5,
        travel_time_seconds = 30,
        energy_cost_megajoules = 5000,
        requires_favorable_nimbus_conditions = false;
    }

    quantum_jump_path "aegis_to_phobos" {
        origin_anchor = "aegis_station_prime",
        destination_anchor = null,
        distance_light_years = 25.8,
        travel_time_seconds = 60,
        energy_cost_megajoules = 8000,
        requires_favorable_nimbus_conditions = true,
        nimbus_condition_threshold = 0.8;
    }

    quantum_weather_system {
        phenomenon = "quantum_nimbus_storm",
        affects_jump_safety = true,
        safety_reduction_percentage = 40,
        duration_variation_minutes = [15, 120],
        affected_radius_light_years = 5.0;
    }
}

planet_generation_systems {
    planet_generator "terrestrial_world_gen" {
        generator_type = "procedural_terrain",
        base_biomes = ["forest", "desert", "tundra", "ocean"],
        terrain_detail_levels = [3, 5, 7],
        supports_dynamic_weather = true,
        weather_systems = ["rain", "snow", "dust_storms"];
    }

    planet_generator "gas_giant_gen" {
        generator_type = "atmospheric_volumes",
        cloud_layers = 5,
        turbulence_factor = 0.85,
        color_gradients = ["brown", "tan", "white"],
        has_ring_system = false;
    }

    planet_generator "asteroid_field_gen" {
        generator_type = "procedural_clusters",
        cluster_density_per_cubic_km = 0.5,
        size_variation_meters = [10, 500],
        composition_types = ["rocky", "metallic", "icy"],
        spawn_resource_nodes = true;
    }

    biome_config "forest_biome" {
        vegetation_density = 0.75,
        tree_height_range_meters = [15, 45],
        ground_texture_types = ["dirt", "grass", "moss"],
        wildlife_spawns = ["avian_flock", "ground_forager"],
        resource_nodes = ["timber_wood", "herb_medical"];
    }

    biome_config "desert_biome" {
        vegetation_density = 0.05,
        terrain_roughness = 0.3,
        ground_texture_types = ["sand", "rock_bare"],
        wildlife_spawns = ["reptile_cruiser"],
        resource_nodes = ["minerals_salts", "fossil_fuels"];
    }
}
