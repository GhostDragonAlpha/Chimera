game "PlanetGenerationTestGame" {
    engine_version = "5.8";
    target_platforms = ["PC", "PS5", "XboxSeries"];
}

technical {
    network_model = "client_server";
    performance { target_fps=60, LOD_strategy="standard" };
    module_dependencies = ["PCG", "PCGGeometryScriptInterop", "Niagara", "AIModule"];
}

planet_generation_systems {
    planet_generator "terrestrial_world_gen" {
        generator_type = "procedural_terrain";
        base_biomes = ["forest", "desert", "tundra", "ocean"];
        terrain_detail_levels = [3, 5, 7];
        supports_dynamic_weather = true;
        weather_systems = ["rain", "snow", "dust_storms"];
    }

    planet_generator "gas_giant_gen" {
        generator_type = "atmospheric_volumes";
        cloud_layers = 5;
        turbulence_factor = 0.85;
        color_gradients = ["brown", "tan", "white"];
        has_ring_system = false;
    }

    planet_generator "asteroid_field_gen" {
        generator_type = "procedural_clusters";
        cluster_density_per_cubic_km = 0.5;
        size_variation_meters = [10, 500];
        composition_types = ["rocky", "metallic", "icy"];
        spawn_resource_nodes = true;
    }

    biome_config "forest_biome" {
        vegetation_density = 0.75;
        tree_height_range_meters = [15, 45];
        ground_texture_types = ["dirt", "grass", "moss"];
        wildlife_spawns = ["avian_flock", "ground_forager"];
        resource_nodes = ["timber_wood", "herb_medical"];
    }

    biome_config "desert_biome" {
        vegetation_density = 0.05;
        terrain_roughness = 0.3;
        ground_texture_types = ["sand", "rock_bare"];
        wildlife_spawns = ["reptile_cruiser"];
        resource_nodes = ["minerals_salts", "fossil_fuels"];
    }
}
