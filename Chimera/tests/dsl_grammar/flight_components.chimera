game "FlightComponentsTestGame" {
    engine_version = "5.8";
    target_platforms = ["PC"];
}

technical {
    network_model = "client_server";
    performance { target_fps=60, LOD_strategy="standard" };
    module_dependencies = ["EnhancedInput", "GameplayAbilities", "GameplayTags", "GameplayTasks"];
}

flight_components {
    component "thruster_module_class_A" {
        type = "chemical_thruster";
        thrust_force_newtons = 50000;
        fuel_consumption_kg_per_sec = 12.5;
        fuel_type = "hydrazine";
        max_temperature_kelvin = 3500;
    }

    component "quantum_drive_core" {
        type = "quantum_travel_drive";
        energy_requirement_megajoules = 10000;
        cool_down_seconds = 45;
        requires_quantum_anchor = true;
        max_range_light_years = 100;
    }

    component "shield_generator_marine" {
        type = "energy_shield";
        shield_strength_points = 5000;
        regeneration_rate_per_sec = 50;
        energy_drain_per_hit = 200;
        shield_type = "kinetic_energy_absorbing";
    }

    component "sensor_array_tactical" {
        type = "long_range_scanner";
        detection_range_km = 50000;
        scan_modes = ["passive", "active_radar", "emission_signatures"];
        jamming_resistance_level = 3;
    }
}
