game "EconomyTestGame" {
    engine_version = "5.8";
    target_platforms = ["PC", "PS5", "XboxSeries"];
}

technical {
    network_model = "client_server";
    performance { target_fps=60, LOD_strategy="standard" };
    module_dependencies = ["NetCore", "CommonUI", "UMG", "GameplayTasks"];
}

economy_systems {
    commodity "minerals_iron" {
        category = "raw_materials";
        base_value_credits = 150;
        market_volatility = 0.05;
        production_locations = ["asteroid_belts", "terrestrial_minings"];
        consumption_regions = ["ship_yards", "construction_zones"];
    }

    commodity "minerals_gold" {
        category = "raw_materials";
        base_value_credits = 8500;
        market_volatility = 0.12;
        production_locations = ["asteroid_belts"];
        consumption_regions = ["luxury_goods", "electronics"];
    }

    commodity "food_synthetic" {
        category = "consumables";
        base_value_credits = 45;
        market_volatility = 0.02;
        production_locations = ["orbital_farms", "terrestrial_agriculture"];
        consumption_regions = ["all_populated_systems"];
    }

    commodity "weapons_military" {
        category = "military_goods";
        base_value_credits = 15000;
        market_volatility = 0.15;
        production_locations = ["defense_contractors"];
        consumption_regions = ["military_outposts", "pirate_havens"];
        trade_restrictions = ["licensed_only"];
    }

    trade_route "core_to_outer_rim" {
        origin_system = "aegis";
        destination_systems = ["crocus", "phobos", "elysium"];
        typical_cargo_types = ["minerals_iron", "food_synthetic"];
        route_safety_rating = 0.75;
        pirate_activity_level = "moderate";
    }
}
