game "ShipClassesTestGame" {
    engine_version = "5.8";
    target_platforms = ["PC", "PS5", "XboxSeries"];
}

technical {
    network_model = "client_server";
    performance { target_fps=60, LOD_strategy="standard" };
    module_dependencies = ["EnhancedInput", "GameplayAbilities", "GameplayTags", "NetCore", "AIModule"];
}

ship_classes {
    ship_class "MoleHauler" {
        category = "freighter";
        crew_capacity = 2;
        cargo_volume_cubic_meters = 5000;
        has_quantum_drive = true;
        has_weapon_systems = false;
        max_speed_km_per_sec = 150;
        shield_class = "light";
    }

    ship_class "Carrack" {
        category = "exploration_vessel";
        crew_capacity = 4;
        cargo_volume_cubic_meters = 2500;
        has_quantum_drive = true;
        has_weapon_systems = true;
        weapon_slots = 4;
        max_speed_km_per_sec = 120;
        shield_class = "medium";
    }

    ship_class "AresMauler" {
        category = "fighter";
        crew_capacity = 1;
        cargo_volume_cubic_meters = 100;
        has_quantum_drive = false;
        has_weapon_systems = true;
        weapon_slots = 6;
        max_speed_km_per_sec = 350;
        shield_class = "light";
        maneuverability_rating = 8;
    }

    ship_class "GladiusFighter" {
        category = "fighter";
        crew_capacity = 1;
        cargo_volume_cubic_meters = 50;
        has_quantum_drive = false;
        has_weapon_systems = true;
        weapon_slots = 4;
        max_speed_km_per_sec = 400;
        shield_class = "light";
        maneuverability_rating = 9;
    }

    ship_class "CutlassRed" {
        category = "multirole_fighter";
        crew_capacity = 3;
        cargo_volume_cubic_meters = 800;
        has_quantum_drive = true;
        has_weapon_systems = true;
        weapon_slots = 2;
        max_speed_km_per_sec = 180;
        shield_class = "medium";
    }
}
