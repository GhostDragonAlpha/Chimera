{
  "DefaultTarget": "ChimeraEditor",
  "DefaultTargets": [
    "ChimeraEditor"
  ],
  "PlatformSettings": {
    "DefaultPlatform": "Win64",
    "Architecture": "x64",
    "SupportedPlatforms": ["Win64"]
  },
  "ConfigurationSettings": {
    "DefaultConfiguration": "Development",
    "Configurations": [
      {
        "Name": "DebugGame",
        "Description": "Debug configuration for game module (development with debug symbols)",
        "UseDebugCompilerFlags": true,
        "OptimizationLevel": 0
      },
      {
        "Name": "Development",
        "Description": "Standard development build with optimizations and debug info",
        "UseDebugCompilerFlags": false,
        "OptimizationLevel": 1
      },
      {
        "Name": "Shipping",
        "Description": "Release shipping build (optimized, no debug symbols)",
        "UseDebugCompilerFlags": false,
        "OptimizationLevel": 2
      },
      {
        "Name": "Test",
        "Description": "Test configuration for automated testing",
        "UseDebugCompilerFlags": true,
        "OptimizationLevel": 0
      }
    ]
  },
  "PluginDependencies": [
    {
      "Name": "PythonScriptPlugin",
      "Priority": 1,
      "Description": "Python scripting support for Unreal Engine"
    },
    {
      "Name": "McpAutomationBridge",
      "Priority": 2,
      "Dependencies": ["PythonScriptPlugin"],
      "Description": "Model Context Protocol automation bridge plugin"
    }
  ],
  "CompilationOrder": [
    "Core",
    "CoreUObject",
    "Engine",
    "InputCore",
    "EnhancedInput",
    "ChaosVehicles",
    "PhysicsCore",
    "UMG",
    "Slate",
    "PythonScriptPlugin",
    "McpAutomationBridge"
  ],
  "MemorySettings": {
    "MinimumRAM_GB": 8,
    "RecommendedRAM_GB": 16,
    "HighEndRAM_GB": 32,
    "UnityBuildChunkSize_KB": {
      "LowMemory_2GB": 128,
      "MediumMemory_4GB": 256,
      "StandardMemory_8GB": 512,
      "HighEndMemory_16GB": 1024
    },
    "MaxParallelCompilers": {
      "LowMemory_2GB": 2,
      "MediumMemory_4GB": 4,
      "StandardMemory_8GB": 8,
      "HighEndMemory_16GB": 16,
      "AutoDetect": true
    }
  },
  "BuildPaths": {
    "IntermediateDir": "Intermediate",
    "SavedDir": "Saved",
    "BinariesDir": "Binaries",
    "PluginsDir": "Plugins",
    "SourceDir": "Source"
  },
  "LoggingSettings": {
    "LogDirectory": "E:\\PythonChimera\\build_logs",
    "MaxLogSize_MB": 100,
    "RetentionDays": 30,
    "StructuredLogsEnabled": true,
    "VerboseMode": false
  },
  "ValidationSettings": {
    "ExpectedDlls": [
      "*ChimeraEditor*.dll",
      "McpAutomationBridge.dll",
      "PythonScriptPlugin.dll"
    ],
    "CheckCompileErrorsInLogs": true,
    "MaxAllowedWarnings": 100,
    "MaxAllowedErrors": 0
  }
}
